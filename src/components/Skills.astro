---
import { Shield, Terminal, Code, Globe, Server, Database } from 'lucide-astro';

const expertise = [
  {
    code: "SEC.01",
    icon: Shield,
    title: "Penetration Testing",
    description: "Offensive web application security assessments, blackbox & whitebox testing, and vulnerability chaining.",
    tools: ["Burp Suite Pro", "Metasploit", "OWASP ZAP", "SQLMap"]
  },
  {
    code: "SYS.02",
    icon: Terminal,
    title: "Linux Hardening",
    description: "System administration, kernel sysctl tuning, strict user permission models, and CIS compliance audits.",
    tools: ["CIS Benchmarks", "AppArmor", "UFW / iptables", "systemd"]
  },
  {
    code: "DEV.03",
    icon: Code,
    title: "Security Tooling",
    description: "Building fast, custom vulnerability scanners, automation bots, and defensive auditing suites.",
    tools: ["Rust", "Tauri v2", "Python 3", "Bash Scripting"]
  },
  {
    code: "NET.04",
    icon: Globe,
    title: "Network Recon",
    description: "Deep packet inspection, service fingerprinting, protocol analysis, and firewall penetration testing.",
    tools: ["Nmap", "Wireshark", "Scapy", "Zeek / Snort"]
  },
  {
    code: "CLD.05",
    icon: Server,
    title: "Cloud & Container Sec",
    description: "Hardening cloud architectures, Docker container isolation, and CI/CD secret scanning pipelines.",
    tools: ["Docker", "AWS IAM", "Trivy", "GitHub Actions"]
  },
  {
    code: "FOR.06",
    icon: Database,
    title: "Incident Forensics",
    description: "Digital forensics, reverse engineering basic payloads, log analysis, and threat hunting.",
    tools: ["Ghidra", "GDB", "Volatility", "YARA Rules"]
  }
];
---

<section id="skills" class="py-16 sm:py-24 md:py-32 border-b border-border bg-background relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Index Header -->
    <div class="skills-anim-item flex items-baseline justify-between pb-4 sm:pb-6 border-b border-border mb-8 sm:mb-12">
      <div class="flex items-center gap-3">
        <span class="swiss-number">02</span>
        <h2 class="text-xs font-mono font-bold uppercase tracking-widest text-foreground">
          // CAPABILITIES &amp; AUDIT DOMAINS
        </h2>
      </div>
      <span class="font-mono text-xs text-muted-foreground hidden sm:inline">
        MODULAR_GRID: 6_CELLS
      </span>
    </div>

    <!-- Section Intro Header -->
    <div class="max-w-3xl mb-8 sm:mb-12 space-y-2.5 sm:space-y-3 skills-anim-item">
      <span class="swiss-tag">AUDIT SCOPE</span>
      <h3 class="text-2xl sm:text-3xl md:text-4xl font-black uppercase tracking-tight text-foreground leading-[1.1]">
        Offensive Precision &amp; Defensive Hardening
      </h3>
      <p class="text-xs sm:text-sm md:text-base text-muted-foreground leading-relaxed">
        Systematic domain expertise organized for high-consequence enterprise environments and continuous compliance.
      </p>
    </div>

    <!-- Swiss 6-Module Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border-t border-l border-border bg-card">
      {expertise.map((item) => {
        const Icon = item.icon;
        return (
          <div class="skill-cell p-5 sm:p-7 md:p-8 border-r border-b border-border hover:bg-secondary/40 transition-colors flex flex-col justify-between space-y-5 sm:space-y-6 group">
            <div class="space-y-3 sm:space-y-4">
              <!-- Cell Header -->
              <div class="flex items-center justify-between font-mono text-xs">
                <span class="font-bold text-primary tracking-wider">
                  [ {item.code} ]
                </span>
                <Icon class="w-4 h-4 text-muted-foreground group-hover:text-primary transition-colors" />
              </div>

              <!-- Title & Description -->
              <div class="space-y-1.5 sm:space-y-2">
                <h4 class="text-base sm:text-lg font-bold uppercase tracking-tight text-foreground group-hover:text-primary transition-colors">
                  {item.title}
                </h4>
                <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
                  {item.description}
                </p>
              </div>
            </div>

            <!-- Tool Tags -->
            <div class="pt-3.5 sm:pt-4 border-t border-border flex flex-wrap gap-1.5 font-mono text-[10px]">
              {item.tools.map((t) => (
                <span class="px-2 py-0.5 border border-border bg-background text-foreground font-medium">
                  {t}
                </span>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  import { animate, createTimeline, stagger } from 'animejs';

  function initSkills() {
    const skillsSection = document.getElementById('skills');
    if (!skillsSection) return;

    let hasAnimated = false;

    function runEntrance() {
      if (hasAnimated) return;
      hasAnimated = true;

      const cells = skillsSection?.querySelectorAll('.skill-cell, .skills-anim-item');
      if (cells && cells.length > 0) {
        createTimeline({ defaults: { ease: 'outExpo' } })
          .add(cells, {
            opacity: [0, 1],
            translateY: [15, 0],
            delay: stagger(60),
            duration: 600
          });
      }
    }

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            runEntrance();
            observer.disconnect();
          }
        });
      }, { threshold: 0.1 });

      observer.observe(skillsSection);
    } else {
      runEntrance();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSkills);
  } else {
    initSkills();
  }
</script>
