---
import { Play, Code, Sparkles, RefreshCw, Terminal, Eye, EyeOff, ShieldAlert } from 'lucide-astro';
---

<div
  id="anime-hud-controller"
  class="fixed bottom-6 left-6 z-50 font-mono text-xs select-none transition-all duration-300"
>
  <!-- Trigger Button (when minimized) -->
  <button
    id="anime-hud-toggle"
    type="button"
    class="flex items-center gap-2.5 px-4 py-2.5 rounded-full bg-card/90 dark:bg-card/90 border border-primary/40 text-primary hover:text-primary-foreground hover:bg-primary backdrop-blur-md shadow-lg hover:shadow-primary/30 transition-all duration-300 cursor-pointer group"
    aria-label="Toggle Anime.js Animation Studio"
  >
    <Sparkles class="w-4 h-4 text-primary group-hover:text-primary-foreground group-hover:rotate-45 transition-transform" />
    <span class="font-semibold tracking-wider">ANIME.JS STUDIO</span>
    <span class="w-2 h-2 rounded-full bg-primary animate-ping"></span>
  </button>

  <!-- Expanded Modal / HUD Card -->
  <div
    id="anime-hud-card"
    class="hidden mt-3 w-80 sm:w-96 rounded-2xl border border-primary/40 bg-card/95 dark:bg-card/90 backdrop-blur-2xl shadow-2xl p-5 overflow-hidden animate-fade-in"
  >
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-border/60 pb-3 mb-4">
      <div class="flex items-center gap-2">
        <Terminal class="w-4 h-4 text-primary" />
        <span class="font-bold text-foreground tracking-tight">Anime.js v4 Control HUD</span>
      </div>
      <button
        id="anime-hud-close"
        type="button"
        class="p-1 rounded hover:bg-muted text-muted-foreground hover:text-foreground transition-colors cursor-pointer"
        aria-label="Close HUD"
      >
        ✕
      </button>
    </div>

    <!-- Quick Action Presets -->
    <div class="space-y-3 mb-4">
      <div class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider">
        // Live Animation Triggers
      </div>

      <div class="grid grid-cols-2 gap-2">
        <button
          id="hud-trigger-decrypt"
          type="button"
          class="flex items-center justify-center gap-1.5 p-2 rounded-lg bg-primary/10 hover:bg-primary/20 text-primary border border-primary/30 font-semibold text-xs transition-all hover:scale-102 active:scale-98 cursor-pointer"
        >
          <Sparkles class="w-3.5 h-3.5" />
          Decrypt Text
        </button>

        <button
          id="hud-trigger-pulse"
          type="button"
          class="flex items-center justify-center gap-1.5 p-2 rounded-lg bg-primary/10 hover:bg-primary/20 text-primary border border-primary/30 font-semibold text-xs transition-all hover:scale-102 active:scale-98 cursor-pointer"
        >
          <RefreshCw class="w-3.5 h-3.5" />
          Matrix Pulse
        </button>

        <button
          id="hud-trigger-spring"
          type="button"
          class="flex items-center justify-center gap-1.5 p-2 rounded-lg bg-primary/10 hover:bg-primary/20 text-primary border border-primary/30 font-semibold text-xs transition-all hover:scale-102 active:scale-98 cursor-pointer"
        >
          <ShieldAlert class="w-3.5 h-3.5" />
          Spring Shake
        </button>

        <button
          id="hud-trigger-scatter"
          type="button"
          class="flex items-center justify-center gap-1.5 p-2 rounded-lg bg-primary/10 hover:bg-primary/20 text-primary border border-primary/30 font-semibold text-xs transition-all hover:scale-102 active:scale-98 cursor-pointer"
        >
          <Play class="w-3.5 h-3.5" />
          Scatter Badges
        </button>
      </div>
    </div>

    <!-- Real-time Anime.js Code Display -->
    <div class="space-y-2">
      <div class="flex items-center justify-between text-[11px] text-muted-foreground">
        <span class="flex items-center gap-1 font-semibold">
          <Code class="w-3 h-3 text-primary" /> Active Anime.js v4 Code:
        </span>
      </div>

      <div class="relative rounded-lg bg-background/90 p-3 border border-border/80 text-[11px] leading-relaxed text-foreground overflow-x-auto max-h-36 font-mono">
        <pre id="hud-code-snippet"><code class="text-primary font-mono">// Click any trigger above to view the live Anime.js call!</code></pre>
      </div>
    </div>

    <div class="mt-4 pt-3 border-t border-border/40 flex items-center justify-between text-[10px] text-muted-foreground">
      <span>Engine: Anime.js v4.5</span>
      <a href="https://animejs.com" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
        animejs.com ↗
      </a>
    </div>
  </div>
</div>

<script>
  import { animate, createTimeline, createSpring, stagger } from 'animejs';

  function initHUD() {
    const toggleBtn = document.getElementById('anime-hud-toggle');
    const closeBtn = document.getElementById('anime-hud-close');
    const card = document.getElementById('anime-hud-card');
    const codeSnippet = document.getElementById('hud-code-snippet');

    if (!toggleBtn || !card) return;

    function openCard() {
      toggleBtn?.classList.add('hidden');
      card?.classList.remove('hidden');
      card?.classList.add('block');
      animate(card, {
        opacity: [0, 1],
        translateY: [20, 0],
        scale: [0.95, 1],
        duration: 300,
        ease: 'outBack'
      });
    }

    function closeCard() {
      animate(card, {
        opacity: [1, 0],
        translateY: [0, 20],
        scale: [1, 0.95],
        duration: 200,
        ease: 'inQuad',
        onComplete: () => {
          card?.classList.add('hidden');
          card?.classList.remove('block');
          toggleBtn?.classList.remove('hidden');
        }
      });
    }

    toggleBtn.addEventListener('click', openCard);
    closeBtn?.addEventListener('click', closeCard);

    // 1. Trigger Decrypt
    document.getElementById('hud-trigger-decrypt')?.addEventListener('click', () => {
      const decryptElements = document.querySelectorAll('.anime-decrypt-target');
      if (decryptElements.length > 0) {
        decryptElements.forEach((el) => {
          const original = el.getAttribute('data-original-text') || el.textContent || '';
          if (!el.getAttribute('data-original-text')) {
            el.setAttribute('data-original-text', original);
          }
          const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*<>[]{}';
          let iteration = 0;

          const interval = setInterval(() => {
            el.textContent = original
              .split('')
              .map((char, index) => {
                if (char === ' ' || char === '\n') return char;
                if (index < iteration) return original[index];
                return chars[Math.floor(Math.random() * chars.length)];
              })
              .join('');

            if (iteration >= original.length) {
              clearInterval(interval);
            }
            iteration += 1 / 2;
          }, 30);
        });
      }

      if (codeSnippet) {
        codeSnippet.innerHTML = `<span class="text-secondary">animate</span>(<span class="text-amber-400">'.cyber-title'</span>, {\n  <span class="text-muted-foreground">text:</span> <span class="text-secondary">scrambleText</span>({\n    <span class="text-muted-foreground">chars:</span> <span class="text-amber-400">'01#!$&*%'</span>,\n    <span class="text-muted-foreground">duration:</span> <span class="text-rose-400">1200</span>\n  }),\n  <span class="text-muted-foreground">ease:</span> <span class="text-amber-400">'outExpo'</span>\n});`;
      }
    });

    // 2. Trigger Matrix Pulse
    document.getElementById('hud-trigger-pulse')?.addEventListener('click', () => {
      const nodes = document.querySelectorAll('.cyber-node');
      if (nodes.length > 0) {
        animate(nodes, {
          scale: [
            { to: 0.3, duration: 180 },
            { to: 1.4, duration: 300, ease: 'outBack' },
            { to: 1, duration: 300, ease: 'outElastic' }
          ],
          backgroundColor: [
            { to: 'hsl(142, 80%, 55%)', duration: 180 },
            { to: 'hsl(142, 76%, 45%, 0.1)', duration: 400 }
          ],
          delay: stagger(40, { grid: [14, 14], from: 'center' })
        });
      }

      if (codeSnippet) {
        codeSnippet.innerHTML = `<span class="text-secondary">animate</span>(<span class="text-amber-400">'.cyber-node'</span>, {\n  <span class="text-muted-foreground">scale:</span> [<span class="text-rose-400">0.3</span>, <span class="text-rose-400">1.4</span>, <span class="text-rose-400">1</span>],\n  <span class="text-muted-foreground">delay:</span> <span class="text-secondary">stagger</span>(<span class="text-rose-400">40</span>, {\n    <span class="text-muted-foreground">grid:</span> [<span class="text-rose-400">14</span>, <span class="text-rose-400">14</span>],\n    <span class="text-muted-foreground">from:</span> <span class="text-amber-400">'center'</span>\n  }),\n  <span class="text-muted-foreground">ease:</span> <span class="text-amber-400">'outElastic(1, .6)'</span>\n});`;
      }
    });

    // 3. Trigger Spring Shake
    document.getElementById('hud-trigger-spring')?.addEventListener('click', () => {
      const cards = document.querySelectorAll('.group');
      animate(cards, {
        rotateZ: [0, -3, 3, -2, 2, 0],
        translateY: [0, -8, 0],
        duration: 800,
        ease: createSpring({
          stiffness: 220,
          damping: 8
        }),
        delay: stagger(80)
      });

      if (codeSnippet) {
        codeSnippet.innerHTML = `<span class="text-secondary">animate</span>(<span class="text-amber-400">'.security-cards'</span>, {\n  <span class="text-muted-foreground">rotateZ:</span> [<span class="text-rose-400">-3</span>, <span class="text-rose-400">3</span>, <span class="text-rose-400">0</span>],\n  <span class="text-muted-foreground">ease:</span> <span class="text-secondary">createSpring</span>({\n    <span class="text-muted-foreground">stiffness:</span> <span class="text-rose-400">220</span>,\n    <span class="text-muted-foreground">damping:</span> <span class="text-rose-400">8</span>\n  }),\n  <span class="text-muted-foreground">delay:</span> <span class="text-secondary">stagger</span>(<span class="text-rose-400">80</span>)\n});`;
      }
    });

    // 4. Trigger Scatter Badges
    document.getElementById('hud-trigger-scatter')?.addEventListener('click', () => {
      const tokens = document.querySelectorAll('.physics-token');
      if (tokens.length > 0) {
        tokens.forEach((token) => {
          const randX = (Math.random() - 0.5) * 200;
          const randY = (Math.random() - 0.5) * 120;
          const randRotate = (Math.random() - 0.5) * 60;

          animate(token, {
            x: randX,
            y: randY,
            rotate: randRotate,
            ease: createSpring({ stiffness: 120, damping: 8 }),
            duration: 600
          });
        });
      }

      if (codeSnippet) {
        codeSnippet.innerHTML = `<span class="text-secondary">createDraggable</span>(<span class="text-amber-400">'.physics-token'</span>, {\n  <span class="text-muted-foreground">container:</span> <span class="text-amber-400">'#sandbox'</span>,\n  <span class="text-muted-foreground">releaseEase:</span> <span class="text-secondary">createSpring</span>({\n    <span class="text-muted-foreground">stiffness:</span> <span class="text-rose-400">140</span>,\n    <span class="text-muted-foreground">damping:</span> <span class="text-rose-400">10</span>\n  })\n});`;
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHUD);
  } else {
    initHUD();
  }
</script>
