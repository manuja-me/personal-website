---
import { ArrowUpRight, Github, Linkedin, FileText, Copy } from 'lucide-astro';
import { siteConfig } from '../data/site';
---

<section id="hero" class="relative pt-20 pb-12 sm:pt-28 sm:pb-16 md:pt-36 md:pb-20 border-b border-border bg-background">
  <!-- Subtle Swiss Grid Pattern -->
  <div class="absolute inset-0 swiss-grid-pattern opacity-40 dark:opacity-20 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-8 sm:space-y-12">
    <!-- Top Status Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 sm:pb-6 border-b border-border font-mono text-xs text-muted-foreground uppercase tracking-wider">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 bg-primary inline-block"></span>
        <span>{siteConfig.location.toUpperCase()} // {siteConfig.timezone}</span>
      </div>

      <div class="flex items-center gap-2 text-foreground font-medium">
        <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full inline-block animate-pulse"></span>
        <span>{siteConfig.availability}</span>
      </div>
    </div>

    <!-- Main Typographic Poster Block -->
    <div class="space-y-4 sm:space-y-6">
      <div class="font-mono text-xs font-bold tracking-widest text-primary uppercase">
        // CYBERSECURITY SPECIALIST &amp; SYSTEMS BUILDER
      </div>

      <h1 
        id="hero-main-title"
        class="text-4xl sm:text-6xl md:text-8xl lg:text-[6.8rem] font-black uppercase tracking-tighter leading-[0.92] text-foreground cursor-pointer select-text"
        title="Click to scramble typography"
      >
        <span class="decrypt-line block" data-value="MANUJA">MANUJA</span>
        <span class="decrypt-line block" data-value="MEDHANKARA">MEDHANKARA</span>
      </h1>

      <p class="text-base sm:text-xl text-muted-foreground font-normal max-w-3xl leading-relaxed pt-2">
        {siteConfig.description}
      </p>
    </div>

    <!-- Action & Connection Bar -->
    <div class="pt-6 sm:pt-8 border-t border-border flex flex-col md:flex-row md:items-center justify-between gap-4">
      <!-- Direct Actions -->
      <div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
        <a
          href={`mailto:${siteConfig.email}?subject=Security%20Inquiry%20from%20Portfolio`}
          class="inline-flex items-center gap-2 px-5 py-3 bg-primary text-primary-foreground font-mono text-xs font-bold uppercase tracking-wider hover:bg-swiss-redDark transition-colors shadow-sm"
          aria-label={`Send security inquiry email to ${siteConfig.author}`}
        >
          <span>Initiate Contact</span>
          <ArrowUpRight class="w-4 h-4" />
        </a>

        <a
          href="/resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-3 border border-border bg-card hover:bg-secondary text-foreground font-mono text-xs font-bold uppercase tracking-wider transition-colors"
          aria-label={`Open ${siteConfig.author}'s resume in PDF format`}
        >
          <FileText class="w-3.5 h-3.5 text-primary" />
          <span>Resume</span>
        </a>

        <button
          type="button"
          class="inline-flex items-center gap-1.5 px-4 py-3 border border-border bg-card hover:bg-secondary text-foreground font-mono text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer"
          title="Copy Email Address"
          aria-label={`Copy ${siteConfig.author}'s email address to clipboard`}
          data-copy={siteConfig.email}
          data-copied-text="COPIED!"
        >
          <Copy class="w-3.5 h-3.5 text-primary" />
          <span data-copy-label>Copy Email</span>
        </button>
      </div>

      <!-- Social Links -->
      <div class="flex items-center gap-2">
        <a
          href={siteConfig.socials.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-2.5 border border-border bg-card hover:bg-secondary text-foreground font-mono text-xs font-semibold uppercase transition-colors"
          aria-label={`Visit ${siteConfig.author}'s GitHub profile`}
        >
          <Github class="w-3.5 h-3.5" />
          <span>GitHub</span>
        </a>
        <a
          href={siteConfig.socials.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-2.5 border border-border bg-card hover:bg-secondary text-foreground font-mono text-xs font-semibold uppercase transition-colors"
          aria-label={`Visit ${siteConfig.author}'s LinkedIn profile`}
        >
          <Linkedin class="w-3.5 h-3.5" />
          <span>LinkedIn</span>
        </a>
      </div>
    </div>

    <!-- Inline Domains Indicator -->
    <div class="pt-4 border-t border-border/60 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs font-mono text-muted-foreground">
      <span class="font-bold text-foreground">DOMAINS:</span>
      <a href="#skill-sec-01" class="hover:text-primary transition-colors">Penetration Testing</a>
      <span class="text-border">/</span>
      <a href="#skill-sys-02" class="hover:text-primary transition-colors">Linux Hardening</a>
      <span class="text-border">/</span>
      <a href="#skill-dev-03" class="hover:text-primary transition-colors">Security Tooling</a>
      <span class="text-border">/</span>
      <span class="text-muted-foreground">Zero-Trust Baseline</span>
    </div>
  </div>
</section>

<script>
  function initHero() {
    // Decrypt scramble effect on click
    const mainTitle = document.getElementById('hero-main-title');
    if (mainTitle) {
      const lineElements = mainTitle.querySelectorAll('.decrypt-line') as NodeListOf<HTMLElement>;
      const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#$*-_+/';

      function runDecrypt() {
        lineElements.forEach((lineEl) => {
          const original = lineEl.getAttribute('data-value') || lineEl.innerText.trim();
          let iteration = 0;
          const interval = setInterval(() => {
            lineEl.innerText = original
              .split('')
              .map((char, index) => {
                if (char === ' ') return ' ';
                if (index < iteration) return original[index];
                return chars[Math.floor(Math.random() * chars.length)];
              })
              .join('');

            if (iteration >= original.length) {
              clearInterval(interval);
              lineEl.innerText = original;
            }
            iteration += 0.5;
          }, 30);
        });
      }

      mainTitle.addEventListener('click', runDecrypt);
    }

  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero);
  } else {
    initHero();
  }
</script>
