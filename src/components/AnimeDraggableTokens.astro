---
import { Shield, Terminal, Bug, Cpu, Lock, RotateCcw, Shuffle, Grab } from 'lucide-astro';

const badges = [
  { id: 'badge-1', label: 'Penetration Testing', icon: Shield, color: 'border-emerald-500/40 text-emerald-400 bg-emerald-500/10' },
  { id: 'badge-2', label: 'Linux Hardening', icon: Terminal, color: 'border-primary/40 text-primary bg-primary/10' },
  { id: 'badge-3', label: 'Kernel Exploits', icon: Bug, color: 'border-rose-500/40 text-rose-400 bg-rose-500/10' },
  { id: 'badge-4', label: 'Tauri v2 + Rust', icon: Cpu, color: 'border-cyan-500/40 text-cyan-400 bg-cyan-500/10' },
  { id: 'badge-5', label: 'Zero-Day Research', icon: Lock, color: 'border-amber-500/40 text-amber-400 bg-amber-500/10' },
  { id: 'badge-6', label: 'CIS Benchmark Audits', icon: Shield, color: 'border-emerald-500/40 text-emerald-400 bg-emerald-500/10' }
];
---

<div class="my-10 p-6 md:p-8 rounded-2xl border border-primary/30 bg-card/70 backdrop-blur-xl shadow-lg relative overflow-hidden" id="draggable-arena-container">
  <!-- HUD Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 mb-6 border-b border-border/50 font-mono text-xs">
    <div class="flex items-center gap-2">
      <Grab class="w-4 h-4 text-primary animate-bounce" />
      <span class="font-bold text-foreground uppercase tracking-wider">// Physics Token Arena (Anime.js Draggable)</span>
    </div>
    <div class="flex items-center gap-2">
      <button
        id="btn-scatter-tokens"
        type="button"
        class="inline-flex items-center gap-1 px-3 py-1.5 rounded bg-muted hover:bg-primary/20 hover:text-primary text-muted-foreground transition-all cursor-pointer text-xs"
        title="Scatter tokens with spring physics"
      >
        <Shuffle class="w-3.5 h-3.5" />
        Scatter
      </button>
      <button
        id="btn-reset-tokens"
        type="button"
        class="inline-flex items-center gap-1 px-3 py-1.5 rounded bg-muted hover:bg-primary/20 hover:text-primary text-muted-foreground transition-all cursor-pointer text-xs"
        title="Reset token positions"
      >
        <RotateCcw class="w-3.5 h-3.5" />
        Reset
      </button>
    </div>
  </div>

  <p class="text-xs text-muted-foreground font-mono mb-6">
    💡 <strong class="text-foreground">Interactive physics:</strong> Grab, drag, and throw the badges below. Built with <span class="text-primary">createDraggable()</span> and <span class="text-primary">createSpring()</span>.
  </p>

  <!-- Interactive Sandbox Canvas Area -->
  <div
    id="draggable-sandbox"
    class="relative w-full h-64 md:h-72 rounded-xl bg-background/50 border border-dashed border-primary/25 overflow-hidden flex flex-wrap items-center justify-center gap-3 p-4 select-none touch-none"
  >
    {badges.map((b) => {
      const Icon = b.icon;
      return (
        <div
          class={`physics-token cursor-grab active:cursor-grabbing inline-flex items-center gap-2 px-4 py-2.5 rounded-full border shadow-md font-mono text-xs md:text-sm font-semibold transition-shadow hover:shadow-[0_0_15px_hsl(var(--primary)/0.3)] select-none z-10 ${b.color}`}
          data-badge-id={b.id}
        >
          <Icon class="w-4 h-4 pointer-events-none" />
          <span class="pointer-events-none">{b.label}</span>
        </div>
      );
    })}
  </div>

  <div class="mt-4 flex items-center justify-between text-[11px] font-mono text-muted-foreground">
    <span>Spring Stiffness: 140 | Damping: 10</span>
    <span class="text-primary">Inertia Enabled</span>
  </div>
</div>

<script>
  import { createDraggable, createSpring, animate, stagger } from 'animejs';

  function initPhysicsArena() {
    const arena = document.getElementById('draggable-sandbox');
    if (!arena) return;

    const tokens = arena.querySelectorAll('.physics-token') as NodeListOf<HTMLElement>;
    if (!tokens || tokens.length === 0) return;

    // Initialize Draggable on each token
    tokens.forEach((token) => {
      createDraggable(token, {
        container: arena,
        releaseEase: createSpring({
          stiffness: 140,
          damping: 10,
          mass: 1
        }),
        onGrab: () => {
          token.classList.add('z-30', 'scale-105');
          token.classList.remove('z-10');
        },
        onRelease: () => {
          token.classList.remove('scale-105');
          setTimeout(() => {
            token.classList.remove('z-30');
            token.classList.add('z-10');
          }, 300);
        }
      });
    });

    // Scatter button
    document.getElementById('btn-scatter-tokens')?.addEventListener('click', () => {
      const bounds = arena.getBoundingClientRect();
      const maxX = (bounds.width / 2) - 80;
      const maxY = (bounds.height / 2) - 40;

      tokens.forEach((token) => {
        const randX = (Math.random() - 0.5) * (maxX * 1.5);
        const randY = (Math.random() - 0.5) * (maxY * 1.5);
        const randRotate = (Math.random() - 0.5) * 40;

        animate(token, {
          x: randX,
          y: randY,
          rotate: randRotate,
          ease: createSpring({
            stiffness: 100,
            damping: 8
          }),
          duration: 600
        });
      });
    });

    // Reset button
    document.getElementById('btn-reset-tokens')?.addEventListener('click', () => {
      animate(tokens, {
        x: 0,
        y: 0,
        rotate: 0,
        ease: createSpring({
          stiffness: 180,
          damping: 12
        }),
        delay: stagger(40)
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPhysicsArena);
  } else {
    initPhysicsArena();
  }
</script>
