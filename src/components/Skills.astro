---
import { Shield, Terminal, Code, Globe, Server, Database } from 'lucide-astro';

const expertise = [
  {
    code: "SEC.01",
    icon: Shield,
    title: "Penetration Testing",
    description: "Offensive web application security assessments, vulnerability chaining, and comprehensive blackbox auditing.",
    scope: "OWASP Top 10 · REST/GraphQL APIs · Business Logic"
  },
  {
    code: "SYS.02",
    icon: Terminal,
    title: "Linux Hardening",
    description: "System administration, kernel sysctl tuning, strict user permission models, and automated compliance auditing.",
    scope: "CIS Benchmarks · AppArmor · iptables/nftables · systemd"
  },
  {
    code: "DEV.03",
    icon: Code,
    title: "Security Tooling",
    description: "Engineering high-speed custom vulnerability scanners, automation daemons, and defensive auditing utilities.",
    scope: "Rust · Tauri v2 · Python · Bash Scripting"
  },
  {
    code: "NET.04",
    icon: Globe,
    title: "Network Recon",
    description: "Packet inspection, service fingerprinting, protocol analysis, and external attack surface discovery.",
    scope: "Nmap · Wireshark · Scapy · Zeek"
  },
  {
    code: "CLD.05",
    icon: Server,
    title: "Cloud & Container Sec",
    description: "Container isolation, minimal base images, CI/CD secret scanning pipelines, and cloud posture evaluation.",
    scope: "Docker · AWS IAM · Trivy · GitHub Actions"
  },
  {
    code: "FOR.06",
    icon: Database,
    title: "Incident Forensics",
    description: "Digital forensics, payload inspection, endpoint artifact parsing, log analysis, and threat hunting.",
    scope: "Ghidra · GDB · Volatility · YARA"
  }
];
---

<section id="skills" class="scroll-mt-16 py-16 sm:py-24 border-b border-border bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Index Header -->
    <div class="flex items-center gap-3 pb-4 sm:pb-6 border-b border-border mb-8 sm:mb-12">
      <span class="swiss-number">02</span>
      <h2 class="text-xs font-mono font-bold uppercase tracking-widest text-foreground">
        // CAPABILITIES &amp; AUDIT DOMAINS
      </h2>
    </div>

    <!-- Swiss 6-Module Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border-t border-l border-border bg-card">
      {expertise.map((item) => {
        const Icon = item.icon;
        const cellId = 'skill-' + item.code.toLowerCase().replace('.', '-');
        return (
          <div id={cellId} class="scroll-mt-24 p-6 sm:p-8 border-r border-b border-border hover:bg-secondary/30 transition-colors flex flex-col justify-between space-y-4 group">
            <div class="space-y-3">
              <div class="flex items-center justify-between font-mono text-xs">
                <span class="font-bold text-primary tracking-wider">
                  [ {item.code} ]
                </span>
                <Icon class="w-4 h-4 text-muted-foreground group-hover:text-primary transition-colors" />
              </div>

              <h3 class="text-lg font-bold uppercase tracking-tight text-foreground group-hover:text-primary transition-colors">
                {item.title}
              </h3>

              <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
                {item.description}
              </p>
            </div>

            <div class="pt-3 border-t border-border/60 font-mono text-[11px] text-muted-foreground">
              <span class="text-foreground font-semibold">Scope:</span> {item.scope}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

