---
import { Mail } from 'lucide-astro';
---

<section id="contact" class="min-h-screen py-24 px-6 flex items-center relative overflow-hidden">
  <!-- Background Effects -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,hsl(var(--primary)/0.06)_1px,transparent_1px),linear-gradient(to_bottom,hsl(var(--primary)/0.06)_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_80%_50%_at_50%_50%,#000_70%,transparent_110%)] pointer-events-none"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,hsl(var(--primary)/0.1),transparent_70%)] pointer-events-none"></div>

  <div class="container mx-auto max-w-4xl relative z-10">
    <div class="relative overflow-hidden rounded-xl border border-primary/30 bg-card/90 dark:bg-card/40 backdrop-blur-xl shadow-lg dark:shadow-[0_0_80px_-20px_hsl(var(--primary)/0.3)]">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_120%,hsl(var(--primary)/0.15),transparent)] pointer-events-none"></div>
      <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary/50 to-transparent"></div>
      <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary/50 to-transparent"></div>
      
      <div class="relative p-12 md:p-16 text-center">
        <div class="inline-block mb-6">
          <span class="text-primary font-mono text-sm font-semibold">$ echo "Let's connect"</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold mb-6 text-foreground">
          Let's Build Something
          <span class="block gradient-text mt-2">Secure Together</span>
        </h2>
        <p class="text-xl text-muted-foreground mb-10 max-w-2xl mx-auto font-mono">
          Open for collaborations, security research, and interesting projects
        </p>
        <div class="flex justify-center">
          <a href="mailto:manuja.public@gmail.com?subject=Portfolio%20Contact&body=Hi%20Manuja,%0A%0AI%20found%20your%20portfolio%20and%20would%20like%20to%20discuss...">
            <button class="inline-flex items-center justify-center rounded-md bg-primary hover:bg-primary/90 text-primary-foreground font-semibold px-10 py-5 text-lg glow-terminal shadow-md cursor-pointer transition-all duration-300">
              <Mail class="mr-2 h-5 w-5" />
              Contact Me
            </button>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
