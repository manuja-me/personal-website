---
import { Mail, Github, Linkedin, ArrowUpRight, ShieldCheck, Key } from 'lucide-astro';
---

<section id="contact" class="py-16 sm:py-24 md:py-32 border-b border-border bg-background relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Index Header -->
    <div class="contact-anim-item flex items-baseline justify-between pb-4 sm:pb-6 border-b border-border mb-8 sm:mb-12">
      <div class="flex items-center gap-3">
        <span class="swiss-number">04</span>
        <h2 class="text-xs font-mono font-bold uppercase tracking-widest text-foreground">
          // COMMUNICATIONS &amp; INQUIRIES
        </h2>
      </div>
      <span class="font-mono text-xs text-muted-foreground hidden sm:inline">
        CHANNELS: ENCRYPTED &amp; OPEN
      </span>
    </div>

    <!-- Main Poster Card -->
    <div class="border border-border bg-card p-5 sm:p-10 md:p-16 contact-anim-item space-y-8 sm:space-y-12">
      <!-- Big Poster Headline -->
      <div class="space-y-3 sm:space-y-4 max-w-3xl">
        <span class="swiss-tag">CONTACT PROTOCOL</span>
        <h3 class="text-3xl sm:text-5xl md:text-6xl font-black uppercase tracking-tight text-foreground leading-[1.0] sm:leading-[0.95]">
          Let's Build Something <span class="text-primary">Secure</span> Together.
        </h3>
        <p class="text-xs sm:text-sm md:text-base text-muted-foreground max-w-2xl leading-relaxed">
          Open for security consultations, penetration testing, systems engineering, compliance audits, and collaborative open-source tooling.
        </p>
      </div>

      <!-- Asymmetric Two-Column Channel Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 pt-6 sm:pt-8 border-t border-border items-start">
        <!-- Direct Email & PGP Box (7 cols) -->
        <div class="lg:col-span-7 space-y-4 sm:space-y-6">
          <div class="font-mono text-xs font-bold uppercase tracking-wider text-muted-foreground">
            [ PRIMARY DISPATCH CHANNEL ]
          </div>

          <a
            id="contact-cta-btn"
            href="mailto:manuja.public@gmail.com?subject=Security%20Inquiry%20from%20Portfolio&body=Hi%20Manuja,%0A%0AI'm%20reaching%20out%20regarding..."
            class="swiss-magnetic-btn swiss-action-trigger w-full inline-flex items-center justify-between p-5 sm:p-7 md:p-8 bg-primary text-primary-foreground hover:bg-swiss-redDark transition-colors group cursor-pointer select-none"
          >
            <div class="min-w-0 pr-3">
              <span class="font-mono text-[10px] sm:text-[11px] tracking-wider uppercase block text-white/80 mb-1">
                Direct Email Transmission
              </span>
              <span class="text-sm sm:text-xl md:text-2xl font-black font-sans uppercase tracking-tight block break-all">
                manuja.public@gmail.com
              </span>
            </div>
            <ArrowUpRight class="w-5 h-5 sm:w-6 sm:h-6 shrink-0 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" />
          </a>

          <!-- PGP Key Box -->
          <div class="p-3.5 sm:p-4 border border-border bg-secondary/30 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 font-mono text-xs">
            <div class="flex items-center gap-2 flex-wrap">
              <Key class="w-4 h-4 text-primary shrink-0" />
              <span class="text-foreground font-semibold">PGP FINGERPRINT:</span>
              <span class="text-muted-foreground">0x4E5AB5C</span>
            </div>
            <a href="/security.txt" class="swiss-action-trigger text-primary font-bold hover:underline">
              security.txt ↗
            </a>
          </div>
        </div>

        <!-- External Profiles & SLA (5 cols) -->
        <div class="lg:col-span-5 space-y-4">
          <div class="font-mono text-xs font-bold uppercase tracking-wider text-muted-foreground">
            [ VERIFIED NETWORKS ]
          </div>

          <div class="space-y-2">
            <a
              href="https://github.com/manuja-me"
              target="_blank"
              rel="noopener noreferrer"
              class="swiss-action-trigger w-full flex items-center justify-between p-3.5 sm:p-4 border border-border bg-card hover:bg-secondary text-foreground font-mono text-xs font-bold uppercase transition-colors group"
            >
              <div class="flex items-center gap-3">
                <Github class="w-4 h-4 text-muted-foreground group-hover:text-primary transition-colors" />
                <span>GitHub Archive</span>
              </div>
              <span class="text-muted-foreground group-hover:text-foreground">@manuja-me ↗</span>
            </a>

            <a
              href="https://www.linkedin.com/in/manuja-medhankara-rc96"
              target="_blank"
              rel="noopener noreferrer"
              class="swiss-action-trigger w-full flex items-center justify-between p-3.5 sm:p-4 border border-border bg-card hover:bg-secondary text-foreground font-mono text-xs font-bold uppercase transition-colors group"
            >
              <div class="flex items-center gap-3">
                <Linkedin class="w-4 h-4 text-muted-foreground group-hover:text-primary transition-colors" />
                <span>LinkedIn Network</span>
              </div>
              <span class="text-muted-foreground group-hover:text-foreground">Connect ↗</span>
            </a>
          </div>

          <div class="p-3 border border-border bg-secondary/20 font-mono text-[11px] text-muted-foreground flex items-center justify-between">
            <span>RESPONSE SLA</span>
            <span class="font-bold text-foreground">&lt; 24 HOURS</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate, createTimeline, createSpring, stagger } from 'animejs';

  function initContact() {
    const contactSection = document.getElementById('contact');
    if (!contactSection) return;

    let hasAnimated = false;

    function runEntrance() {
      if (hasAnimated) return;
      hasAnimated = true;

      const items = contactSection?.querySelectorAll('.contact-anim-item');
      if (items && items.length > 0) {
        createTimeline({ defaults: { ease: 'outExpo' } })
          .add(items, {
            opacity: [0, 1],
            translateY: [20, 0],
            delay: stagger(90),
            duration: 650
          });
      }
    }

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            runEntrance();
            observer.disconnect();
          }
        });
      }, { threshold: 0.1 });

      observer.observe(contactSection);
    } else {
      runEntrance();
    }

    // Magnetic Button Physics
    const magneticButtons = document.querySelectorAll('.swiss-magnetic-btn') as NodeListOf<HTMLElement>;
    magneticButtons.forEach((btn) => {
      btn.addEventListener('mousemove', (e) => {
        const rect = btn.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;

        animate(btn, {
          x: x * 0.15,
          y: y * 0.15,
          duration: 120,
          ease: 'outQuad'
        });
      });

      btn.addEventListener('mouseleave', () => {
        animate(btn, {
          x: 0,
          y: 0,
          ease: createSpring({
            stiffness: 300,
            damping: 12
          })
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContact);
  } else {
    initContact();
  }
</script>
