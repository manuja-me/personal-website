---
import { ArrowUp, ArrowUpRight } from 'lucide-astro';

const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-border bg-background relative">
  <!-- Architectural Wordmark Banner: Filled with Monumental & Overlapping Watermark Typography -->
  <div class="relative overflow-hidden border-b border-border bg-card/30 dark:bg-card/20 select-none py-12 sm:py-16 md:py-24">
    <!-- Subtle Swiss Grid Texture -->
    <div class="absolute inset-0 swiss-grid-pattern opacity-30 dark:opacity-15 pointer-events-none"></div>

    <!-- Background Multi-Row Watermark Texture (Fills Section Vertically & Horizontally) -->
    <div 
      aria-hidden="true" 
      class="absolute inset-0 overflow-hidden pointer-events-none select-none opacity-[0.04] dark:opacity-[0.055] flex flex-col justify-between py-2 sm:py-4"
    >
      <div class="whitespace-nowrap font-sans font-black text-5xl sm:text-7xl md:text-9xl uppercase tracking-tighter leading-none -translate-x-12">
        MANUJA MEDHANKARA &bull; MANUJA MEDHANKARA &bull; MANUJA MEDHANKARA &bull; MANUJA MEDHANKARA
      </div>
      <div class="whitespace-nowrap font-sans font-black text-6xl sm:text-8xl md:text-[10rem] uppercase tracking-tighter leading-none translate-x-16">
        MEDHANKARA MANUJA &bull; MEDHANKARA MANUJA &bull; MEDHANKARA MANUJA &bull; MEDHANKARA MANUJA
      </div>
      <div class="whitespace-nowrap font-sans font-black text-5xl sm:text-7xl md:text-9xl uppercase tracking-tighter leading-none -translate-x-28">
        MANUJA MEDHANKARA &bull; MANUJA MEDHANKARA &bull; MANUJA MEDHANKARA &bull; MANUJA MEDHANKARA
      </div>
    </div>

    <!-- Floating Ghost Outline Overlapping Layer -->
    <div
      aria-hidden="true"
      class="absolute top-1/2 -translate-y-1/2 left-0 right-0 overflow-hidden whitespace-nowrap pointer-events-none select-none z-0"
    >
      <div class="font-sans font-black text-6xl sm:text-8xl md:text-[10rem] lg:text-[12rem] uppercase tracking-tighter text-transparent [-webkit-text-stroke:1px_rgba(0,0,0,0.08)] dark:[-webkit-text-stroke:1px_rgba(255,255,255,0.08)] translate-y-6 sm:translate-y-8 translate-x-4 sm:translate-x-8">
        MANUJA MEDHANKARA &bull; MANUJA MEDHANKARA
      </div>
    </div>

    <!-- Foreground Content Container -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 sm:space-y-8">
      <!-- Top Status & Specification Tag -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 sm:pb-4 border-b border-border/60 font-mono text-xs uppercase tracking-widest text-muted-foreground">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-primary inline-block"></span>
          <span class="font-bold text-foreground">MANUJA MEDHANKARA</span>
          <span class="text-border">/</span>
          <span>SYSTEM DOSSIER</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-foreground font-semibold">COLOMBO, LK</span>
          <span>&bull;</span>
          <span>CYBERSECURITY &amp; SYSTEMS ENGINEERING</span>
        </div>
      </div>

      <!-- Monumental Foreground Wordmark with Overlapping Accent Shadow -->
      <div class="relative py-2 sm:py-4">
        <!-- Direct Overlapping Outline Shadow Layer -->
        <div
          aria-hidden="true"
          class="absolute -top-1 sm:-top-2 left-1 sm:left-2 font-sans font-black text-4xl sm:text-6xl md:text-8xl lg:text-[7.6rem] xl:text-[8.8rem] uppercase tracking-tighter leading-[0.88] text-transparent [-webkit-text-stroke:1.5px_hsl(var(--primary)/0.25)] dark:[-webkit-text-stroke:1.5px_hsl(var(--primary)/0.35)] pointer-events-none select-none"
        >
          MANUJA MEDHANKARA
        </div>

        <!-- Primary High-Contrast Heading -->
        <h2
          class="relative font-sans text-4xl sm:text-6xl md:text-8xl lg:text-[7.5rem] xl:text-[8.7rem] font-black tracking-tighter leading-[0.88] text-foreground uppercase select-text group"
        >
          <span class="text-foreground inline-block transition-transform duration-300 group-hover:translate-x-1">MANUJA</span>
          <span class="text-primary inline-block transition-transform duration-300 group-hover:-translate-x-1 ml-1.5 sm:ml-3 md:ml-5">MEDHANKARA</span>
        </h2>
      </div>

      <!-- Bottom Domain Capabilities Strip -->
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 pt-3 border-t border-border/50 font-mono text-[11px] text-muted-foreground uppercase">
        <span class="text-foreground font-bold tracking-wider">DOMAINS:</span>
        <span class="hover:text-primary transition-colors">PENETRATION TESTING</span>
        <span class="text-border">/</span>
        <span class="hover:text-primary transition-colors">LINUX HARDENING</span>
        <span class="text-border">/</span>
        <span class="hover:text-primary transition-colors">OFFENSIVE RESEARCH</span>
        <span class="text-border">/</span>
        <span class="hover:text-primary transition-colors">RUST &amp; TAURI SYSTEMS</span>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- 4-Column Directory Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 sm:gap-10 pb-10 sm:pb-16 border-b border-border">
      <!-- Col 1: Discipline & Location (5 cols) -->
      <div class="lg:col-span-5 space-y-3">
        <div class="flex items-center gap-2 font-mono text-xs font-bold text-foreground uppercase tracking-wider">
          <span class="w-1.5 h-1.5 bg-primary"></span>
          <span>Focus &amp; Discipline</span>
        </div>
        <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed max-w-sm">
          Offensive penetration testing, Linux kernel hardening, zero-trust infrastructure, and high-performance security utilities.
        </p>
        <div class="font-mono text-xs text-muted-foreground pt-1">
          Colombo, LK &bull; UTC+05:30
        </div>
      </div>

      <!-- Col 2: Navigation (2 cols) -->
      <div class="lg:col-span-2 space-y-2.5 font-mono text-xs">
        <h3 class="font-bold text-foreground uppercase tracking-wider mb-2 sm:mb-3">
          Navigation
        </h3>
        <ul class="space-y-1.5 text-muted-foreground">
          <li>
            <a href="#hero" class="hover:text-primary transition-colors flex items-center gap-1.5">
              <span class="text-primary font-bold">00</span> Home
            </a>
          </li>
          <li>
            <a href="#about" class="hover:text-primary transition-colors flex items-center gap-1.5">
              <span class="text-primary font-bold">01</span> About
            </a>
          </li>
          <li>
            <a href="#skills" class="hover:text-primary transition-colors flex items-center gap-1.5">
              <span class="text-primary font-bold">02</span> Capabilities
            </a>
          </li>
          <li>
            <a href="#projects" class="hover:text-primary transition-colors flex items-center gap-1.5">
              <span class="text-primary font-bold">03</span> Projects
            </a>
          </li>
          <li>
            <a href="#contact" class="hover:text-primary transition-colors flex items-center gap-1.5">
              <span class="text-primary font-bold">04</span> Contact
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Repositories (3 cols) -->
      <div class="lg:col-span-3 space-y-2.5 font-mono text-xs">
        <h3 class="font-bold text-foreground uppercase tracking-wider mb-2 sm:mb-3">
          Repositories
        </h3>
        <ul class="space-y-1.5 text-muted-foreground">
          <li>
            <a
              href="https://github.com/manuja-me/vuln-radar"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-primary transition-colors inline-flex items-center gap-1"
              aria-label="View VulnRadar Security Scanner repository on GitHub"
            >
              <span>VulnRadar Scanner</span>
              <ArrowUpRight class="w-3 h-3 opacity-60" />
            </a>
          </li>
          <li>
            <a
              href="https://github.com/manuja-me"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-primary transition-colors inline-flex items-center gap-1"
              aria-label="View Linux Hardening Suite repository on GitHub"
            >
              <span>Linux Hardening Suite</span>
              <ArrowUpRight class="w-3 h-3 opacity-60" />
            </a>
          </li>
          <li>
            <a
              href="https://github.com/manuja-me"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-primary transition-colors inline-flex items-center gap-1"
              aria-label="View Manuja Medhankara's profile on GitHub"
            >
              <span>GitHub Profile</span>
              <ArrowUpRight class="w-3 h-3 opacity-60" />
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/manuja-medhankara-rc96"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-primary transition-colors inline-flex items-center gap-1"
              aria-label="Connect with Manuja Medhankara on LinkedIn"
            >
              <span>LinkedIn Network</span>
              <ArrowUpRight class="w-3 h-3 opacity-60" />
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Top & Security (2 cols) -->
      <div class="lg:col-span-2 flex flex-col justify-between space-y-4 font-mono text-xs pt-4 md:pt-0 border-t md:border-t-0 border-border/50">
        <div class="space-y-2">
          <h3 class="font-bold text-foreground uppercase tracking-wider mb-2 sm:mb-3">
            Security
          </h3>
          <a href="/security.txt" class="block text-muted-foreground hover:text-primary transition-colors">
            security.txt ↗
          </a>
          <span class="block text-muted-foreground text-[11px]">
            PGP: 0x4E5AB5C
          </span>
        </div>

        <!-- Back to Top Button -->
        <div>
          <a
            href="#hero"
            class="swiss-action-trigger inline-flex items-center justify-between w-full p-2.5 border border-border bg-card hover:bg-secondary text-foreground font-bold uppercase tracking-wider transition-colors cursor-pointer text-xs"
            aria-label="Back to top"
          >
            <span>Top of Page</span>
            <ArrowUp class="w-3.5 h-3.5 text-primary" />
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Meta Copyright Bar -->
    <div class="pt-6 sm:pt-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-4 font-mono text-xs text-muted-foreground">
      <div class="flex items-center gap-2">
        <span>&copy; {currentYear} Manuja Medhankara. All rights reserved.</span>
      </div>

      <div class="flex items-center gap-2 text-[11px]">
        <span>Designed with Swiss typography principles</span>
      </div>
    </div>
  </div>
</footer>
