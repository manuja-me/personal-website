---
import { Github, ChevronDown, ExternalLink, ArrowUpRight } from 'lucide-astro';

interface ProjectTimelineItem {
  id: string;
  index: string;
  title: string;
  url: string;
  status: 'completed' | 'in_development' | 'planned';
  statusLabel: string;
  phase: string;
  description: string;
  highlights: string[];
  tags: string[];
}

const projects: ProjectTimelineItem[] = [
  {
    id: "vulnradar",
    index: "01",
    title: "VulnRadar Security Scanner",
    url: "https://github.com/manuja-me/vuln-radar",
    status: "completed",
    statusLabel: "RELEASED",
    phase: "v0.7 PRODUCTION",
    description: "Enterprise-grade desktop security workstation & non-intrusive vulnerability scanner. Conducts real-time attack surface evaluations, cryptographic audits, port discovery, and OWASP remediation blueprinting.",
    highlights: [
      "Passive & non-destructive audits: HTTP security headers, cookie hygiene, and SSL/TLS cryptographic posture",
      "Attack surface heuristics: detects dangerous query parameters (?cmd=, ?tpl=), CVE banner correlation, and debug consoles",
      "High-speed async TCP port discovery with banner grabbing and target profile presets",
      "DNS & anti-spoofing verification: DoH inspection for SPF (v=spf1), DMARC policies (p=reject), and DNSSEC integrity",
      "Multi-source subdomain reconnaissance via Certificate Transparency logs (crt.sh) and passive DNS",
      "1-Click AI remediation prompts, continuous watchdog daemon, and local SQLite (WAL) privacy"
    ],
    tags: ["Rust", "Tauri v2", "Svelte 5", "Tailwind CSS", "SQLite WAL"]
  },
  {
    id: "linux-hardening",
    index: "02",
    title: "Linux Hardening Suite",
    url: "https://github.com/manuja-me",
    status: "in_development",
    statusLabel: "ACTIVE DEV",
    phase: "STAGING v1.0",
    description: "Automated security hardening suite for Linux servers following CIS benchmarks with customizable rule sets, dry-run validations, and automatic rollbacks.",
    highlights: [
      "Automated compliance checks aligned with CIS Benchmarks & NIST security baselines",
      "SSH, UFW/iptables firewall, kernel sysctl tuning, and strict user permission audits",
      "Non-destructive dry-run validation with automatic configuration backups and rollbacks",
      "Modular multi-distro architecture targeting Debian, Ubuntu, and Arch Linux"
    ],
    tags: ["Bash", "Python", "Linux Security", "CIS Benchmarks", "Automation"]
  },
  {
    id: "network-scanner",
    index: "03",
    title: "Network Recon Pro",
    url: "https://github.com/manuja-me",
    status: "planned",
    statusLabel: "PLANNED",
    phase: "ROADMAP",
    description: "Advanced network reconnaissance and asset discovery tool with service fingerprinting, vulnerability scanning, and automated reporting.",
    highlights: [
      "High-speed asynchronous port scanning with service and banner detection",
      "Integrated vulnerability script engine with CVE catalog matching",
      "Exportable security assessment reports in JSON, Markdown, and HTML formats"
    ],
    tags: ["Python", "Nmap", "Scapy", "Network Security"]
  }
];
---

<section id="projects" class="py-24 md:py-32 border-b border-border bg-background relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Index Header -->
    <div class="projects-anim-item flex items-baseline justify-between pb-6 border-b border-border mb-12">
      <div class="flex items-center gap-3">
        <span class="swiss-number">03</span>
        <h2 class="text-xs font-mono font-bold uppercase tracking-widest text-foreground">
          // SELECTED WORKS &amp; ROADMAP
        </h2>
      </div>
      <span class="font-mono text-xs text-muted-foreground hidden sm:inline">
        CATALOG_INDEX: 3_PROJECTS
      </span>
    </div>

    <!-- Section Intro Header -->
    <div class="max-w-3xl mb-12 space-y-3 projects-anim-item">
      <span class="swiss-tag">OPEN SOURCE &amp; TOOLING</span>
      <h3 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-foreground">
        Architected for Reliability &amp; Speed
      </h3>
      <p class="text-sm sm:text-base text-muted-foreground leading-relaxed">
        Chronological index of security tooling, automated hardening engines, and offensive auditing utilities.
      </p>
    </div>

    <!-- Swiss Catalog List -->
    <div class="border-t border-border divide-y divide-border">
      {projects.map((project) => (
        <div class="project-item group" data-project-id={project.id}>
          <!-- Row Header Button -->
          <button
            type="button"
            class="w-full py-8 text-left flex flex-col md:flex-row md:items-center justify-between gap-6 cursor-pointer focus:outline-none focus-visible:ring-1 focus-visible:ring-primary project-toggle-btn hover:bg-secondary/30 px-4 -mx-4 transition-colors"
            aria-expanded="false"
            aria-controls={`details-${project.id}`}
          >
            <!-- Left: Index + Title + Short Description -->
            <div class="flex items-start gap-6 flex-1">
              <span class="font-mono font-bold text-lg text-primary shrink-0 pt-0.5">
                {project.index}
              </span>
              <div class="space-y-1.5">
                <div class="flex flex-wrap items-center gap-3">
                  <h4 class="text-xl sm:text-2xl font-black uppercase tracking-tight text-foreground group-hover:text-primary transition-colors">
                    {project.title}
                  </h4>
                  <span class="font-mono text-[10px] uppercase font-bold px-2 py-0.5 border border-border bg-card text-foreground">
                    {project.statusLabel}
                  </span>
                  <span class="font-mono text-[10px] text-muted-foreground tracking-wider uppercase">
                    [{project.phase}]
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-muted-foreground max-w-3xl leading-relaxed">
                  {project.description}
                </p>
              </div>
            </div>

            <!-- Right: Action Links & Toggle Indicator -->
            <div class="flex items-center gap-4 shrink-0 pl-12 md:pl-0">
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="p-2 border border-border bg-card hover:bg-secondary text-foreground hover:text-primary transition-colors"
                aria-label={`View ${project.title} source on GitHub`}
                onclick="event.stopPropagation()"
              >
                <Github class="w-4 h-4" />
              </a>

              <div class="flex items-center gap-1 font-mono text-xs text-muted-foreground group-hover:text-primary transition-colors">
                <span class="hidden sm:inline uppercase text-[11px] font-semibold">SPECS</span>
                <div class="chevron-icon transition-transform duration-300">
                  <ChevronDown class="w-4 h-4" />
                </div>
              </div>
            </div>
          </button>

          <!-- Expandable Technical Drawer -->
          <div
            id={`details-${project.id}`}
            class="hidden overflow-hidden border-t border-dashed border-border bg-card/60 px-6 py-8 project-details-content"
          >
            <div class="space-y-6 max-w-4xl">
              <!-- Feature List -->
              <div class="space-y-3">
                <div class="font-mono text-xs font-bold uppercase tracking-wider text-foreground">
                  [ ARCHITECTURAL CAPABILITIES &amp; SECURITY SCOPE ]
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                  {project.highlights.map((highlight) => (
                    <div class="project-highlight-item flex items-start gap-2.5 font-mono text-xs text-muted-foreground">
                      <span class="text-primary font-bold">―</span>
                      <span class="leading-relaxed">{highlight}</span>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Tech Stack & Direct URL -->
              <div class="pt-6 border-t border-border flex flex-wrap items-center justify-between gap-4">
                <div class="flex flex-wrap gap-1.5 font-mono text-[10px]">
                  {project.tags.map((tag) => (
                    <span class="px-2.5 py-1 border border-border bg-background text-foreground font-semibold">
                      {tag}
                    </span>
                  ))}
                </div>

                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 font-mono text-xs font-bold uppercase tracking-wider text-primary hover:underline group/link"
                >
                  <span>Repository</span>
                  <ArrowUpRight class="w-3.5 h-3.5 transition-transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5" />
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { animate, createTimeline, stagger } from 'animejs';

  function initProjects() {
    const projectsSection = document.getElementById('projects');
    if (!projectsSection) return;

    let hasAnimated = false;

    function runEntrance() {
      if (hasAnimated) return;
      hasAnimated = true;

      const items = projectsSection?.querySelectorAll('.project-item, .projects-anim-item');
      if (items && items.length > 0) {
        createTimeline({ defaults: { ease: 'outExpo' } })
          .add(items, {
            opacity: [0, 1],
            translateY: [15, 0],
            delay: stagger(70),
            duration: 600
          });
      }
    }

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            runEntrance();
            observer.disconnect();
          }
        });
      }, { threshold: 0.1 });

      observer.observe(projectsSection);
    } else {
      runEntrance();
    }

    // Smooth Drawer Accordion
    const projectItems = document.querySelectorAll('.project-item');
    projectItems.forEach((item) => {
      const btn = item.querySelector('.project-toggle-btn');
      const content = item.querySelector('.project-details-content') as HTMLElement;
      const chevron = item.querySelector('.chevron-icon');

      if (!btn || !content) return;

      btn.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) return;

        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        const nextState = !isExpanded;

        btn.setAttribute('aria-expanded', nextState ? 'true' : 'false');

        if (nextState) {
          content.classList.remove('hidden');
          content.classList.add('block');
          content.style.height = '0px';
          content.style.opacity = '0';

          const fullHeight = content.scrollHeight;
          const highlights = content.querySelectorAll('.project-highlight-item');

          animate(content, {
            height: [0, fullHeight],
            opacity: [0, 1],
            duration: 320,
            ease: 'outQuart',
            onComplete: () => {
              content.style.height = 'auto';
            }
          });

          animate(highlights, {
            translateY: [8, 0],
            opacity: [0, 1],
            delay: stagger(25),
            duration: 250,
            ease: 'outExpo'
          });

          if (chevron) {
            animate(chevron, {
              rotate: 180,
              duration: 250,
              ease: 'outExpo'
            });
          }
        } else {
          const currentHeight = content.scrollHeight || content.offsetHeight;
          content.style.height = `${currentHeight}px`;

          animate(content, {
            height: [currentHeight, 0],
            opacity: [1, 0],
            duration: 300,
            ease: 'outQuart',
            onComplete: () => {
              content.classList.remove('block');
              content.classList.add('hidden');
              content.style.height = '';
              content.style.opacity = '';
            }
          });

          if (chevron) {
            animate(chevron, {
              rotate: 0,
              duration: 250,
              ease: 'outExpo'
            });
          }
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjects);
  } else {
    initProjects();
  }
</script>
