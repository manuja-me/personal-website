---
import ThemeToggle from './ThemeToggle.astro';
import { Menu, X } from 'lucide-astro';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-background/95 backdrop-blur-md border-b border-border transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-14">
    <!-- Brand / Identifier -->
    <a href="#hero" class="flex items-center gap-2.5 sm:gap-3 group focus:outline-none focus-visible:ring-1 focus-visible:ring-primary">
      <div class="w-5 h-5 bg-primary flex items-center justify-center text-white font-bold text-xs tracking-tighter select-none shrink-0">
        M
      </div>
      <span class="font-sans font-extrabold text-xs sm:text-sm tracking-tight text-foreground group-hover:text-primary transition-colors uppercase truncate">
        Manuja Medhankara
      </span>
    </a>

    <!-- Desktop Nav Links (Numbered Swiss Index) -->
    <nav class="hidden md:flex items-center gap-8 font-mono text-xs font-semibold tracking-wider text-muted-foreground">
      <a href="#about" class="nav-item-link hover:text-foreground hover:text-primary transition-colors flex items-center gap-1.5 py-1 border-b border-transparent">
        <span class="text-primary font-bold">01</span>
        <span>About</span>
      </a>
      <a href="#skills" class="nav-item-link hover:text-foreground hover:text-primary transition-colors flex items-center gap-1.5 py-1 border-b border-transparent">
        <span class="text-primary font-bold">02</span>
        <span>Capabilities</span>
      </a>
      <a href="#projects" class="nav-item-link hover:text-foreground hover:text-primary transition-colors flex items-center gap-1.5 py-1 border-b border-transparent">
        <span class="text-primary font-bold">03</span>
        <span>Projects</span>
      </a>
      <a href="#contact" class="nav-item-link hover:text-foreground hover:text-primary transition-colors flex items-center gap-1.5 py-1 border-b border-transparent">
        <span class="text-primary font-bold">04</span>
        <span>Contact</span>
      </a>
    </nav>

    <!-- Controls -->
    <div class="flex items-center gap-2.5 sm:gap-4">
      <a
        href="/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 border border-border bg-card hover:border-primary text-foreground font-mono text-xs font-bold tracking-wider uppercase transition-colors"
        title="View Resume / CV"
      >
        <span class="text-primary">Resume</span>
        <span class="text-muted-foreground text-[10px]">↗</span>
      </a>

      <ThemeToggle />

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        class="md:hidden inline-flex items-center justify-center p-1.5 border border-border bg-card text-foreground hover:bg-secondary font-mono text-xs font-bold uppercase tracking-wider focus:outline-none focus-visible:ring-1 focus-visible:ring-primary cursor-pointer"
      >
        <span id="menu-icon-open" class="flex items-center gap-1">
          <Menu class="w-4 h-4" />
          <span class="text-[11px]">Menu</span>
        </span>
        <span id="menu-icon-close" class="hidden items-center gap-1 text-primary">
          <X class="w-4 h-4" />
          <span class="text-[11px]">Close</span>
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation Drawer -->
  <div
    id="mobile-menu-drawer"
    class="grid grid-rows-[0fr] opacity-0 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] overflow-hidden md:hidden border-t border-border bg-background/98 backdrop-blur-xl"
  >
    <div class="min-h-0 overflow-hidden px-4 py-5 space-y-3 font-mono text-xs shadow-xl">
      <div class="grid grid-cols-1 divide-y divide-border border border-border bg-card">
        <a
          href="#about"
          class="mobile-nav-link flex items-center justify-between p-3.5 hover:bg-secondary text-foreground hover:text-primary transition-colors font-semibold"
        >
          <span>About</span>
          <span class="text-primary font-bold">01</span>
        </a>
        <a
          href="#skills"
          class="mobile-nav-link flex items-center justify-between p-3.5 hover:bg-secondary text-foreground hover:text-primary transition-colors font-semibold"
        >
          <span>Capabilities</span>
          <span class="text-primary font-bold">02</span>
        </a>
        <a
          href="#projects"
          class="mobile-nav-link flex items-center justify-between p-3.5 hover:bg-secondary text-foreground hover:text-primary transition-colors font-semibold"
        >
          <span>Projects</span>
          <span class="text-primary font-bold">03</span>
        </a>
        <a
          href="#contact"
          class="mobile-nav-link flex items-center justify-between p-3.5 hover:bg-secondary text-foreground hover:text-primary transition-colors font-semibold"
        >
          <span>Contact</span>
          <span class="text-primary font-bold">04</span>
        </a>
        <a
          href="/resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-nav-link flex items-center justify-between p-3.5 hover:bg-secondary text-primary transition-colors font-bold"
        >
          <span>Resume / CV</span>
          <span class="text-primary font-bold">PDF ↗</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  function initNavbar() {
    const toggle = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-menu-drawer');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');
    const navLinks = document.querySelectorAll('.mobile-nav-link');

    if (!toggle || !drawer) return;

    let isMenuOpen = false;

    function setMenuState(open: boolean) {
      isMenuOpen = open;
      toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');

      if (open) {
        drawer?.classList.remove('grid-rows-[0fr]', 'opacity-0');
        drawer?.classList.add('grid-rows-[1fr]', 'opacity-100');
        if (iconOpen) iconOpen.classList.add('hidden');
        if (iconClose) {
          iconClose.classList.remove('hidden');
          iconClose.classList.add('flex');
        }
      } else {
        drawer?.classList.remove('grid-rows-[1fr]', 'opacity-100');
        drawer?.classList.add('grid-rows-[0fr]', 'opacity-0');
        if (iconOpen) iconOpen.classList.remove('hidden');
        if (iconClose) {
          iconClose.classList.add('hidden');
          iconClose.classList.remove('flex');
        }
      }
    }

    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      setMenuState(!isMenuOpen);
    });

    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        setMenuState(false);
      });
    });

    document.addEventListener('click', (e) => {
      if (isMenuOpen && drawer && !drawer.contains(e.target as Node) && !toggle.contains(e.target as Node)) {
        setMenuState(false);
      }
    });

    // Keyboard a11y: Escape closes menu
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isMenuOpen) {
        setMenuState(false);
        toggle.focus();
      }
    });

    // ScrollSpy: highlight active section in desktop navbar
    const sections = document.querySelectorAll('section[id]');
    const desktopLinks = document.querySelectorAll('.nav-item-link');

    if ('IntersectionObserver' in window && sections.length > 0 && desktopLinks.length > 0) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const currentId = entry.target.getAttribute('id');
            desktopLinks.forEach((link) => {
              const href = link.getAttribute('href');
              if (href === `#${currentId}`) {
                link.classList.add('text-foreground', '!border-primary');
                link.classList.remove('text-muted-foreground', 'border-transparent');
              } else {
                link.classList.remove('text-foreground', '!border-primary');
                link.classList.add('text-muted-foreground', 'border-transparent');
              }
            });
          }
        });
      }, {
        root: null,
        rootMargin: '-20% 0px -60% 0px',
        threshold: 0
      });

      sections.forEach((s) => observer.observe(s));
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavbar);
  } else {
    initNavbar();
  }
</script>
