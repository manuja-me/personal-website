---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-background/90 backdrop-blur-md border-b border-border transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-14">
    <!-- Brand / Identifier -->
    <a href="#hero" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-1 focus-visible:ring-primary">
      <div class="w-5 h-5 bg-primary flex items-center justify-center text-white font-bold text-xs tracking-tighter select-none">
        M
      </div>
      <div class="flex items-baseline gap-2">
        <span class="font-sans font-extrabold text-sm tracking-tight text-foreground group-hover:text-primary transition-colors uppercase">
          Manuja Medhankara
        </span>
        <span class="hidden sm:inline font-mono text-[10px] text-muted-foreground tracking-widest uppercase">
          [SEC.ENG]
        </span>
      </div>
    </a>

    <!-- Nav Links (Numbered Swiss Index) -->
    <nav class="hidden md:flex items-center gap-8 font-mono text-xs font-semibold tracking-wider text-muted-foreground">
      <a href="#about" class="hover:text-foreground hover:text-primary transition-colors flex items-center gap-1.5 py-1">
        <span class="text-primary font-bold">01</span>
        <span>ABOUT</span>
      </a>
      <a href="#skills" class="hover:text-foreground hover:text-primary transition-colors flex items-center gap-1.5 py-1">
        <span class="text-primary font-bold">02</span>
        <span>CAPABILITIES</span>
      </a>
      <a href="#projects" class="hover:text-foreground hover:text-primary transition-colors flex items-center gap-1.5 py-1">
        <span class="text-primary font-bold">03</span>
        <span>TIMELINE</span>
      </a>
      <a href="#contact" class="hover:text-foreground hover:text-primary transition-colors flex items-center gap-1.5 py-1">
        <span class="text-primary font-bold">04</span>
        <span>CONTACT</span>
      </a>
    </nav>

    <!-- Operational Telemetry & Theme Switch -->
    <div class="flex items-center gap-4">
      <div class="hidden lg:flex items-center gap-2 border-l border-border pl-4 font-mono text-[11px] text-muted-foreground">
        <span class="w-1.5 h-1.5 bg-emerald-500 inline-block animate-pulse"></span>
        <span class="tracking-widest uppercase">SYSTEMS: ONLINE</span>
      </div>

      <ThemeToggle />
    </div>
  </div>
</header>
