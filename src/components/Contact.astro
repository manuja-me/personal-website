---
import { Mail, Github, Linkedin, ShieldCheck, ArrowUpRight } from 'lucide-astro';
---

<section id="contact" class="min-h-screen py-28 px-6 flex items-center relative overflow-hidden">
  <!-- Background Accents -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,hsl(var(--primary)/0.04)_1px,transparent_1px),linear-gradient(to_bottom,hsl(var(--primary)/0.04)_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,hsl(var(--primary)/0.12),transparent_70%)] pointer-events-none"></div>

  <div class="container mx-auto max-w-4xl relative z-10">
    <div class="contact-card-box relative overflow-hidden rounded-3xl border border-primary/40 bg-card/90 dark:bg-card/50 backdrop-blur-2xl shadow-2xl">
      <!-- Animated Laser Lines Top & Bottom -->
      <div id="contact-top-laser" class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-primary to-transparent"></div>
      <div id="contact-bottom-laser" class="absolute bottom-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-primary to-transparent"></div>
      
      <div class="relative p-10 md:p-16 text-center contact-content-anim">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-primary/10 border border-primary/30 text-primary font-mono text-xs font-semibold mb-6 cursor-pointer group" id="contact-cmd-badge">
          <ShieldCheck class="w-3.5 h-3.5 text-primary" />
          <span class="anime-decrypt-target" data-original-text="$ gpg --initiate-comms">$ gpg --initiate-comms</span>
        </div>

        <!-- Heading -->
        <h2 class="text-4xl md:text-6xl font-black mb-6 text-foreground anime-decrypt-target cursor-pointer tracking-tight" data-original-text="Let's Build Something Secure Together">
          Let's Build Something
          <span class="block gradient-text mt-2">Secure Together</span>
        </h2>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-muted-foreground mb-10 max-w-xl mx-auto font-mono leading-relaxed">
          Open for security consultations, penetration testing, systems engineering, and open-source collaborations.
        </p>

        <!-- Primary CTA -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            id="contact-cta-btn"
            href="mailto:manuja.public@gmail.com?subject=Security%20Inquiry%20from%20Portfolio&body=Hi%20Manuja,%0A%0AI'm%20reaching%20out%20regarding..."
            class="contact-magnetic-btn inline-flex items-center justify-center rounded-xl bg-primary hover:bg-primary/90 text-primary-foreground font-mono font-bold px-8 py-4 text-base glow-terminal shadow-lg cursor-pointer transition-all duration-300 select-none w-full sm:w-auto"
          >
            <Mail class="mr-2 h-5 w-5" />
            Launch Secure Email
          </a>

          <div class="flex gap-3 w-full sm:w-auto justify-center">
            <a
              href="https://github.com/manuja-me"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-magnetic-btn inline-flex items-center justify-center gap-1.5 px-5 py-4 rounded-xl border border-border/80 dark:border-primary/30 hover:border-primary text-foreground hover:text-primary hover:bg-primary/10 bg-card/60 backdrop-blur-md font-mono text-xs font-semibold transition-all shadow-sm"
            >
              <Github class="w-4 h-4" />
              <span>GitHub</span>
              <ArrowUpRight class="w-3.5 h-3.5 opacity-60" />
            </a>
            <a
              href="https://www.linkedin.com/in/manuja-medhankara-rc96"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-magnetic-btn inline-flex items-center justify-center gap-1.5 px-5 py-4 rounded-xl border border-border/80 dark:border-primary/30 hover:border-primary text-foreground hover:text-primary hover:bg-primary/10 bg-card/60 backdrop-blur-md font-mono text-xs font-semibold transition-all shadow-sm"
            >
              <Linkedin class="w-4 h-4" />
              <span>LinkedIn</span>
              <ArrowUpRight class="w-3.5 h-3.5 opacity-60" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate, createSpring, createTimeline } from 'animejs';

  function initContactAnimations() {
    const contactSection = document.getElementById('contact');
    if (!contactSection) return;

    let hasAnimated = false;

    function runEntrance() {
      if (hasAnimated) return;
      hasAnimated = true;

      createTimeline({ defaults: { ease: 'outBack' } })
        .add('.contact-card-box', {
          scale: [0.94, 1],
          opacity: [0, 1],
          duration: 700
        })
        .add('.contact-content-anim > *', {
          translateY: [20, 0],
          opacity: [0, 1],
          duration: 500
        }, '-=400');
    }

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            runEntrance();
            observer.disconnect();
          }
        });
      }, { threshold: 0.2 });

      observer.observe(contactSection);
    } else {
      runEntrance();
    }

    // Laser Beam Animation
    animate('#contact-top-laser', {
      translateX: ['-100%', '100%'],
      duration: 3500,
      loop: true,
      ease: 'inOutSine'
    });

    animate('#contact-bottom-laser', {
      translateX: ['100%', '-100%'],
      duration: 3500,
      loop: true,
      ease: 'inOutSine'
    });

    // Magnetic Button Spring Hover
    const buttons = document.querySelectorAll('.contact-magnetic-btn') as NodeListOf<HTMLElement>;
    buttons.forEach((btn) => {
      btn.addEventListener('mousemove', (e) => {
        const rect = btn.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;

        animate(btn, {
          x: x * 0.25,
          y: y * 0.25,
          duration: 150,
          ease: 'outQuad'
        });
      });

      btn.addEventListener('mouseleave', () => {
        animate(btn, {
          x: 0,
          y: 0,
          ease: createSpring({
            stiffness: 260,
            damping: 10
          })
        });
      });
    });

    // Decrypt on badge hover
    const badge = document.getElementById('contact-cmd-badge');
    if (badge) {
      badge.addEventListener('mouseenter', () => {
        const span = badge.querySelector('.anime-decrypt-target') as HTMLElement;
        if (!span) return;
        const original = span.getAttribute('data-original-text') || span.textContent || '';
        const chars = '01#$*&abcdef';
        let iter = 0;
        const int = setInterval(() => {
          span.textContent = original
            .split('')
            .map((c, i) => (c === ' ' ? ' ' : i < iter ? original[i] : chars[Math.floor(Math.random() * chars.length)]))
            .join('');
          if (iter >= original.length) clearInterval(int);
          iter += 1/2;
        }, 30);
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactAnimations);
  } else {
    initContactAnimations();
  }
</script>
