---
import { Github, ChevronDown, ExternalLink, GitCommit, Sparkles } from 'lucide-astro';

interface ProjectTimelineItem {
  id: string;
  title: string;
  url: string;
  status: 'completed' | 'in_development' | 'planned';
  statusLabel: string;
  badgeColor: string;
  phase: string;
  description: string;
  highlights: string[];
  tags: string[];
}

const projects: ProjectTimelineItem[] = [
  {
    id: "vulnradar",
    title: "VulnRadar",
    url: "https://github.com/manuja-me/vuln-radar",
    status: "completed",
    statusLabel: "Built & Released",
    badgeColor: "text-emerald-700 dark:text-emerald-400 border-emerald-600/30 dark:border-emerald-500/30 bg-emerald-500/10",
    phase: "v0.7 Active",
    description: "Enterprise-grade desktop security workstation & non-intrusive vulnerability scanner. Conducts real-time attack surface evaluations, cryptographic audits, port discovery, and OWASP remediation blueprinting.",
    highlights: [
      "Safe & non-destructive passive audits: HTTP security headers, cookie hygiene, and SSL/TLS cryptographic posture",
      "RCE & attack surface heuristics: detects dangerous query parameters (?cmd=, ?tpl=), CVE banner correlation, and debug consoles",
      "High-speed async TCP port discovery with banner grabbing and target profile presets",
      "DNS & anti-spoofing verification: DoH inspection for SPF (v=spf1), DMARC policies (p=reject), and DNSSEC integrity",
      "Multi-source subdomain reconnaissance via Certificate Transparency logs (crt.sh) and passive DNS",
      "1-Click AI remediation prompts (Antigravity, Claude, ChatGPT), continuous watchdog daemon, and local SQLite (WAL) privacy"
    ],
    tags: ["Rust", "Tauri v2", "Svelte 5", "Tailwind CSS v4", "SQLite WAL"]
  },
  {
    id: "linux-hardening",
    title: "Linux Hardening Suite",
    url: "https://github.com/manuja-me",
    status: "in_development",
    statusLabel: "In Active Dev",
    badgeColor: "text-amber-700 dark:text-amber-400 border-amber-600/30 dark:border-amber-500/30 bg-amber-500/10",
    phase: "Next Release",
    description: "Automated security hardening suite for Linux servers following CIS benchmarks with customizable rule sets and non-destructive audits.",
    highlights: [
      "Automated compliance checks aligned with CIS Benchmarks & NIST security baselines",
      "SSH, UFW/iptables firewall, kernel sysctl tuning, and strict user permission audits",
      "Non-destructive dry-run validation with automatic configuration backups and rollbacks",
      "Modular multi-distro architecture targeting Debian, Ubuntu, and Arch Linux"
    ],
    tags: ["Bash", "Python", "Linux Security", "CIS Benchmarks", "Automation"]
  },
  {
    id: "network-scanner",
    title: "Network Recon Pro",
    url: "https://github.com/manuja-me",
    status: "planned",
    statusLabel: "Planned Roadmap",
    badgeColor: "text-cyan-700 dark:text-cyan-400 border-cyan-600/30 dark:border-cyan-500/30 bg-cyan-500/10",
    phase: "Roadmap",
    description: "Advanced network reconnaissance and asset discovery tool with service fingerprinting, vulnerability scanning, and automated reporting.",
    highlights: [
      "High-speed asynchronous port scanning with service and banner detection",
      "Integrated vulnerability script engine with CVE catalog matching",
      "Exportable security assessment reports in JSON, Markdown, and HTML formats"
    ],
    tags: ["Python", "Nmap", "Scapy", "Reconnaissance"]
  }
];
---

<section id="projects" class="min-h-screen py-28 px-6 relative flex items-center">
  <div class="container mx-auto max-w-5xl">
    <!-- Section Header -->
    <div class="mb-20 projects-header-anim">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-primary/10 border border-primary/30 text-primary font-mono text-xs font-semibold mb-4 cursor-pointer group" id="projects-cmd-badge">
        <GitCommit class="w-3.5 h-3.5 text-primary" />
        <span class="anime-decrypt-target" data-original-text="$ git log --graph --security-roadmap">$ git log --graph --security-roadmap</span>
      </div>
      <h2 class="text-4xl md:text-5xl font-black text-foreground anime-decrypt-target cursor-pointer tracking-tight" data-original-text="Security Tool Roadmap">
        Security Tool <span class="gradient-text">Roadmap</span>
      </h2>
      <p class="text-base sm:text-lg text-muted-foreground font-mono mt-3 max-w-2xl">
        Chronological development timeline of open-source tools, scanners, and active research
      </p>
    </div>

    <!-- Modern Timeline Spine & Tree -->
    <div class="relative border-l-2 border-primary/30 dark:border-primary/25 ml-3 md:ml-4 pl-7 md:pl-10 space-y-8">
      {projects.map((project) => (
        <div class="relative group timeline-item" data-project-id={project.id}>
          <!-- Timeline Beacon Node -->
          <div class="timeline-node absolute -left-[37px] md:-left-[49px] top-7 flex items-center justify-center pointer-events-none">
            {project.status === 'completed' && (
              <div class="relative flex items-center justify-center">
                <div class="w-4 h-4 rounded-full border-2 border-emerald-500 bg-background flex items-center justify-center shadow-[0_0_12px_rgba(16,185,129,0.7)]">
                  <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" />
                </div>
              </div>
            )}
            {project.status === 'in_development' && (
              <div class="relative flex items-center justify-center">
                <span class="animate-ping absolute inline-flex h-5 w-5 rounded-full bg-amber-400/40" />
                <div class="w-4 h-4 rounded-full border-2 border-amber-500 bg-background flex items-center justify-center shadow-[0_0_12px_rgba(245,158,11,0.7)]">
                  <div class="w-2 h-2 rounded-full bg-amber-500" />
                </div>
              </div>
            )}
            {project.status === 'planned' && (
              <div class="relative flex items-center justify-center">
                <div class="w-4 h-4 rounded-full border-2 border-cyan-500/60 bg-background flex items-center justify-center shadow-[0_0_8px_rgba(6,182,212,0.4)]">
                  <div class="w-1.5 h-1.5 rounded-full bg-cyan-500/80" />
                </div>
              </div>
            )}
          </div>

          <!-- Modern Glassmorphic Expandable Project Card -->
          <div class="timeline-card rounded-2xl border border-border/80 dark:border-primary/20 bg-card/85 dark:bg-card/50 backdrop-blur-xl hover:border-primary/60 transition-all duration-300 shadow-md hover:shadow-xl overflow-hidden">
            <!-- Card Header Button -->
            <button
              type="button"
              class="w-full p-6 md:p-8 text-left flex items-start justify-between gap-5 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary timeline-toggle-btn"
              aria-expanded="false"
              aria-controls={`details-${project.id}`}
            >
              <div class="space-y-3 flex-1">
                <!-- Status & Phase Header -->
                <div class="flex flex-wrap items-center gap-2.5">
                  <span class={`text-xs px-3 py-1 rounded-full border font-mono font-bold ${project.badgeColor}`}>
                    {project.statusLabel}
                  </span>
                  <span class="text-xs text-muted-foreground font-mono font-semibold">
                    [{project.phase}]
                  </span>
                </div>

                <!-- Project Title -->
                <h3 class="text-2xl md:text-3xl font-black text-foreground group-hover:text-primary transition-colors tracking-tight font-mono">
                  {project.title}
                </h3>

                <!-- Short Overview -->
                <p class="text-xs sm:text-sm text-muted-foreground font-mono leading-relaxed">
                  {project.description}
                </p>
              </div>

              <!-- Action & Animated Chevron -->
              <div class="flex items-center gap-3 shrink-0 pt-1">
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`View ${project.title} on GitHub`}
                  class="p-2.5 rounded-xl border border-border/80 dark:border-primary/25 hover:border-primary text-muted-foreground hover:text-primary hover:bg-primary/10 transition-colors"
                  onclick="event.stopPropagation()"
                >
                  <Github class="w-4 h-4" />
                </a>
                <div
                  class="p-2.5 rounded-xl bg-muted/60 text-foreground group-hover:bg-primary/15 group-hover:text-primary transition-all duration-300 chevron-icon"
                  title="Toggle details"
                >
                  <ChevronDown class="w-4 h-4" />
                </div>
              </div>
            </button>

            <!-- Collapsible Body Content -->
            <div
              id={`details-${project.id}`}
              class="hidden overflow-hidden border-t border-border/50 timeline-details-content"
            >
              <div class="p-6 md:p-8 pt-5 space-y-6 bg-primary/[0.02]">
                <!-- Key Highlights -->
                <div>
                  <h4 class="text-xs font-mono font-bold text-primary uppercase tracking-wider mb-4">
                    // Key Features &amp; Security Scope
                  </h4>
                  <ul class="space-y-2.5">
                    {project.highlights.map((highlight) => (
                      <li class="project-highlight-item flex items-start gap-2.5 text-xs sm:text-sm text-foreground/90 font-mono">
                        <span class="text-primary font-black mt-0.5 text-sm">▹</span>
                        <span class="leading-relaxed">{highlight}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Tech Badges & Direct Action Link -->
                <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-border/50">
                  <div class="flex flex-wrap gap-2">
                    {project.tags.map((tag) => (
                      <span class="text-xs px-2.5 py-1 bg-primary/10 text-primary border border-primary/25 rounded-md font-mono font-semibold">
                        {tag}
                      </span>
                    ))}
                  </div>

                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 text-xs font-mono font-bold text-primary hover:underline group/link"
                  >
                    <span>View Repository</span>
                    <ExternalLink class="w-3.5 h-3.5 transition-transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5" />
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { animate, createTimeline, stagger } from 'animejs';

  function initTimeline() {
    const projectsSection = document.getElementById('projects');
    if (!projectsSection) return;

    let hasAnimated = false;

    function runEntrance() {
      if (hasAnimated) return;
      hasAnimated = true;

      createTimeline({ defaults: { ease: 'outBack' } })
        .add('.projects-header-anim', {
          opacity: [0, 1],
          translateY: [30, 0],
          duration: 600
        })
        .add('.timeline-item', {
          opacity: [0, 1],
          translateX: [-25, 0],
          delay: stagger(120),
          duration: 600
        }, '-=300');
    }

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            runEntrance();
            observer.disconnect();
          }
        });
      }, { threshold: 0.15 });

      observer.observe(projectsSection);
    } else {
      runEntrance();
    }

    // Anime.js Accordion Expand / Collapse
    const items = document.querySelectorAll('.timeline-item');
    items.forEach((item) => {
      const btn = item.querySelector('.timeline-toggle-btn');
      const content = item.querySelector('.timeline-details-content') as HTMLElement;
      const chevron = item.querySelector('.chevron-icon');

      if (!btn || !content) return;

      btn.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) return;

        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        const nextState = !isExpanded;

        btn.setAttribute('aria-expanded', nextState ? 'true' : 'false');

        if (nextState) {
          content.classList.remove('hidden');
          content.classList.add('block');
          content.style.height = '0px';
          content.style.opacity = '0';
          
          const fullHeight = content.scrollHeight;
          const highlights = content.querySelectorAll('.project-highlight-item');
          
          animate(content, {
            height: [0, fullHeight],
            opacity: [0, 1],
            duration: 350,
            ease: 'outQuart',
            onComplete: () => {
              content.style.height = 'auto';
            }
          });

          animate(highlights, {
            translateX: [-15, 0],
            opacity: [0, 1],
            delay: stagger(35),
            duration: 300,
            ease: 'outBack'
          });

          if (chevron) {
            animate(chevron, {
              rotate: 180,
              duration: 300,
              ease: 'outBack'
            });
          }
        } else {
          const currentHeight = content.scrollHeight || content.offsetHeight;
          content.style.height = `${currentHeight}px`;
          const highlights = content.querySelectorAll('.project-highlight-item');

          // Reverse staggered item exit
          animate(highlights, {
            translateX: [0, -15],
            opacity: [1, 0],
            delay: stagger(25, { from: 'last' }),
            duration: 250,
            ease: 'inOutQuad'
          });

          // Smooth height & opacity collapse
          animate(content, {
            height: [currentHeight, 0],
            opacity: [1, 0],
            duration: 350,
            ease: 'outQuart',
            onComplete: () => {
              content.classList.remove('block');
              content.classList.add('hidden');
              content.style.height = '';
              content.style.opacity = '';
            }
          });

          if (chevron) {
            animate(chevron, {
              rotate: 0,
              duration: 300,
              ease: 'outBack'
            });
          }
        }
      });
    });

    // Decrypt on click
    function runDecrypt(el: HTMLElement) {
      if ((el as any)._decryptInterval) clearInterval((el as any)._decryptInterval);
      const original = el.getAttribute('data-original-text') || el.textContent || '';
      const chars = '01#$*&abcdef';
      let iter = 0;
      const int = setInterval(() => {
        el.textContent = original
          .split('')
          .map((c, i) => (c === ' ' ? ' ' : i < iter ? original[i] : chars[Math.floor(Math.random() * chars.length)]))
          .join('');
        if (iter >= original.length) {
          clearInterval(int);
          (el as any)._decryptInterval = null;
        }
        iter += 0.25;
      }, 45);
      (el as any)._decryptInterval = int;
    }

    const badge = document.getElementById('projects-cmd-badge');
    if (badge) {
      const span = badge.querySelector('.anime-decrypt-target') as HTMLElement;
      if (span) {
        badge.addEventListener('click', () => runDecrypt(span));
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTimeline);
  } else {
    initTimeline();
  }
</script>
