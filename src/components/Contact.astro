---
import { Mail, Github, Linkedin, ArrowUpRight, Key, Copy } from 'lucide-astro';
---

<section id="contact" class="scroll-mt-16 py-16 sm:py-24 border-b border-border bg-background relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="flex items-baseline justify-between pb-4 sm:pb-6 border-b border-border mb-8 sm:mb-12">
      <div class="flex items-center gap-3">
        <span class="swiss-number">04</span>
        <h2 class="text-xs font-mono font-bold uppercase tracking-widest text-foreground">
          Contact
        </h2>
      </div>
      <span class="font-mono text-xs text-muted-foreground hidden sm:inline">
        Direct Inquiries
      </span>
    </div>

    <!-- Main Contact Card -->
    <div class="border border-border bg-card p-6 sm:p-10 md:p-14 space-y-8 sm:space-y-10">
      <!-- Headline & Intro -->
      <div class="space-y-3 sm:space-y-4 max-w-3xl">
        <h3 class="text-3xl sm:text-4xl md:text-5xl font-black uppercase tracking-tight text-foreground leading-[1.05]">
          Let's build something <span class="text-primary">secure</span> together.
        </h3>
        <p class="text-sm md:text-base text-muted-foreground max-w-2xl leading-relaxed">
          Open for security consultations, penetration testing, systems engineering, compliance audits, and collaborative open-source tooling.
        </p>
      </div>

      <!-- Two-Column Channel Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 pt-6 sm:pt-8 border-t border-border items-start">
        <!-- Direct Email & PGP Box (7 cols) -->
        <div class="lg:col-span-7 space-y-4">
          <div class="flex items-center justify-between font-mono text-xs font-bold uppercase tracking-wider text-muted-foreground">
            <span>Direct Email</span>
            <button
              id="contact-copy-email-btn"
              type="button"
              class="inline-flex items-center gap-1.5 px-2.5 py-1 border border-border bg-card hover:bg-secondary text-foreground text-xs font-mono transition-colors cursor-pointer select-none"
              title="Copy Email Address"
            >
              <Copy class="w-3 h-3 text-primary" />
              <span id="contact-copy-email-label">Copy Email</span>
            </button>
          </div>

          <a
            id="contact-cta-btn"
            href="mailto:manuja.public@gmail.com?subject=Security%20Inquiry%20from%20Portfolio&body=Hi%20Manuja,%0A%0AI'm%20reaching%20out%20regarding..."
            class="swiss-action-trigger w-full inline-flex items-center justify-between p-5 sm:p-6 bg-primary text-primary-foreground hover:bg-swiss-redDark transition-colors group cursor-pointer select-none"
          >
            <div class="min-w-0 pr-3">
              <span class="font-mono text-[11px] tracking-wider uppercase block text-white/80 mb-1">
                Click to send email
              </span>
              <span class="text-base sm:text-xl font-bold font-mono tracking-tight block break-all">
                manuja.public@gmail.com
              </span>
            </div>
            <ArrowUpRight class="w-5 h-5 shrink-0 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" />
          </a>

          <!-- PGP Key Box -->
          <div class="p-3.5 sm:p-4 border border-border bg-secondary/30 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 font-mono text-xs">
            <div class="flex items-center gap-2 flex-wrap">
              <Key class="w-4 h-4 text-primary shrink-0" />
              <span class="text-foreground font-semibold">PGP Fingerprint:</span>
              <span class="text-muted-foreground">0x4E5AB5C</span>
              <button
                id="contact-copy-pgp-btn"
                type="button"
                class="inline-flex items-center gap-1 text-[11px] px-2 py-0.5 border border-border bg-card hover:text-primary transition-colors cursor-pointer"
                title="Copy PGP Fingerprint"
              >
                <Copy class="w-2.5 h-2.5 text-primary" />
                <span id="contact-copy-pgp-label">Copy</span>
              </button>
            </div>
            <a href="/security.txt" class="swiss-action-trigger text-primary font-bold hover:underline">
              security.txt ↗
            </a>
          </div>
        </div>

        <!-- External Profiles (5 cols) -->
        <div class="lg:col-span-5 space-y-4">
          <div class="font-mono text-xs font-bold uppercase tracking-wider text-muted-foreground">
            Other Profiles
          </div>

          <div class="space-y-2">
            <a
              href="https://github.com/manuja-me"
              target="_blank"
              rel="noopener noreferrer"
              class="swiss-action-trigger w-full flex items-center justify-between p-3.5 sm:p-4 border border-border bg-card hover:bg-secondary text-foreground font-mono text-xs font-semibold transition-colors group"
            >
              <div class="flex items-center gap-3">
                <Github class="w-4 h-4 text-muted-foreground group-hover:text-primary transition-colors" />
                <span>GitHub</span>
              </div>
              <span class="text-muted-foreground group-hover:text-foreground">@manuja-me ↗</span>
            </a>

            <a
              href="https://www.linkedin.com/in/manuja-medhankara-rc96"
              target="_blank"
              rel="noopener noreferrer"
              class="swiss-action-trigger w-full flex items-center justify-between p-3.5 sm:p-4 border border-border bg-card hover:bg-secondary text-foreground font-mono text-xs font-semibold transition-colors group"
            >
              <div class="flex items-center gap-3">
                <Linkedin class="w-4 h-4 text-muted-foreground group-hover:text-primary transition-colors" />
                <span>LinkedIn</span>
              </div>
              <span class="text-muted-foreground group-hover:text-foreground">Connect ↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initContact() {
    const copyEmailBtn = document.getElementById('contact-copy-email-btn');
    const copyEmailLabel = document.getElementById('contact-copy-email-label');
    if (copyEmailBtn && copyEmailLabel) {
      copyEmailBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('manuja.public@gmail.com');
          const original = copyEmailLabel.innerText;
          copyEmailLabel.innerText = 'Copied!';
          copyEmailBtn.classList.add('border-primary', 'text-primary');
          setTimeout(() => {
            copyEmailLabel.innerText = original;
            copyEmailBtn.classList.remove('border-primary', 'text-primary');
          }, 2000);
        } catch (e) {
          copyEmailLabel.innerText = 'Failed';
        }
      });
    }

    const copyPgpBtn = document.getElementById('contact-copy-pgp-btn');
    const copyPgpLabel = document.getElementById('contact-copy-pgp-label');
    if (copyPgpBtn && copyPgpLabel) {
      copyPgpBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('0x4E5AB5C');
          const original = copyPgpLabel.innerText;
          copyPgpLabel.innerText = 'Copied';
          copyPgpBtn.classList.add('text-primary');
          setTimeout(() => {
            copyPgpLabel.innerText = original;
            copyPgpBtn.classList.remove('text-primary');
          }, 2000);
        } catch (e) {
          copyPgpLabel.innerText = 'Failed';
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContact);
  } else {
    initContact();
  }
</script>
