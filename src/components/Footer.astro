---
import { Terminal, Shield, ArrowUp, Github, Linkedin, Mail, ExternalLink, Activity, Lock } from 'lucide-astro';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border/80 dark:border-primary/25 pt-20 pb-10 px-6 bg-card/60 dark:bg-card/40 backdrop-blur-2xl relative overflow-hidden">
  <!-- Subtle Background Grid Accent -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,hsl(var(--primary)/0.08),transparent_70%)] pointer-events-none"></div>

  <div class="container mx-auto max-w-6xl relative z-10">
    <!-- Top Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 pb-16 border-b border-border/60 dark:border-primary/20">
      <!-- Col 1: Brand & Security Mission (5 cols) -->
      <div class="lg:col-span-5 space-y-5">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-primary/10 border border-primary/30 flex items-center justify-center text-primary shadow-sm">
            <Terminal class="w-5 h-5 text-primary" />
          </div>
          <div>
            <span class="text-xl font-bold font-mono tracking-tight text-foreground">
              manuja<span class="text-primary">.dev</span>
            </span>
            <div class="flex items-center gap-1.5 text-[11px] font-mono text-emerald-600 dark:text-emerald-400">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>DAEMON ACTIVE // STATUS OK</span>
            </div>
          </div>
        </div>

        <p class="text-sm text-muted-foreground font-mono leading-relaxed max-w-sm">
          Cybersecurity Specialist &amp; Linux Systems Builder. Exploring offensive security, vulnerability discovery, and hardening secure infrastructures.
        </p>

        <!-- Command Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-background/80 dark:bg-background/60 border border-border/80 dark:border-primary/20 text-xs font-mono text-muted-foreground">
          <Lock class="w-3.5 h-3.5 text-primary" />
          <span class="text-primary font-medium">$</span> sudo harden --mode=enforce
        </div>
      </div>

      <!-- Col 2: Navigation Links (2 cols) -->
      <div class="lg:col-span-2 space-y-3 font-mono">
        <h4 class="text-xs font-bold text-foreground uppercase tracking-wider mb-4 flex items-center gap-1.5">
          <span class="text-primary">//</span> Navigation
        </h4>
        <ul class="space-y-2.5 text-xs text-muted-foreground">
          <li>
            <a href="#hero" class="hover:text-primary transition-colors flex items-center gap-1">
              <span class="text-primary/60">01.</span> Home
            </a>
          </li>
          <li>
            <a href="#about" class="hover:text-primary transition-colors flex items-center gap-1">
              <span class="text-primary/60">02.</span> About
            </a>
          </li>
          <li>
            <a href="#skills" class="hover:text-primary transition-colors flex items-center gap-1">
              <span class="text-primary/60">03.</span> Capabilities
            </a>
          </li>
          <li>
            <a href="#projects" class="hover:text-primary transition-colors flex items-center gap-1">
              <span class="text-primary/60">04.</span> Roadmap
            </a>
          </li>
          <li>
            <a href="#contact" class="hover:text-primary transition-colors flex items-center gap-1">
              <span class="text-primary/60">05.</span> Contact
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Repositories & Network (3 cols) -->
      <div class="lg:col-span-3 space-y-3 font-mono">
        <h4 class="text-xs font-bold text-foreground uppercase tracking-wider mb-4 flex items-center gap-1.5">
          <span class="text-primary">//</span> Connected Repos
        </h4>
        <ul class="space-y-2.5 text-xs text-muted-foreground">
          <li>
            <a
              href="https://github.com/manuja-me/vuln-radar"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-primary transition-colors inline-flex items-center gap-1.5 group"
            >
              <span>VulnRadar Scanner</span>
              <ExternalLink class="w-3 h-3 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 opacity-60" />
            </a>
          </li>
          <li>
            <a
              href="https://github.com/manuja-me"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-primary transition-colors inline-flex items-center gap-1.5 group"
            >
              <span>Linux Hardening Suite</span>
              <ExternalLink class="w-3 h-3 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 opacity-60" />
            </a>
          </li>
          <li>
            <a
              href="https://github.com/manuja-me"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-primary transition-colors inline-flex items-center gap-1.5 group"
            >
              <span>GitHub Profile</span>
              <ExternalLink class="w-3 h-3 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 opacity-60" />
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/manuja-medhankara-rc96"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-primary transition-colors inline-flex items-center gap-1.5 group"
            >
              <span>LinkedIn Network</span>
              <ExternalLink class="w-3 h-3 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 opacity-60" />
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: System Telemetry & Back to Top (2 cols) -->
      <div class="lg:col-span-2 flex flex-col justify-between space-y-4 font-mono">
        <div>
          <h4 class="text-xs font-bold text-foreground uppercase tracking-wider mb-4 flex items-center gap-1.5">
            <span class="text-primary">//</span> Protocols
          </h4>
          <div class="space-y-2 text-xs text-muted-foreground">
            <a href="/security.txt" class="block hover:text-primary transition-colors">
              security.txt ↗
            </a>
            <span class="block text-[11px] text-muted-foreground/80">
              PGP: 0x4E5AB5C
            </span>
          </div>
        </div>

        <!-- Back to Top Magnetic Button -->
        <div>
          <a
            id="footer-back-to-top"
            href="#hero"
            class="magnetic-button inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-border/80 dark:border-primary/30 hover:border-primary bg-background/80 dark:bg-background/60 text-foreground hover:text-primary transition-all text-xs font-semibold shadow-sm cursor-pointer"
            aria-label="Back to top"
          >
            <ArrowUp class="w-3.5 h-3.5 text-primary" />
            <span>Top of Matrix</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Massive Giant Brand Name Section (Hero Brand Display) -->
    <div class="pt-12 pb-6 text-right select-none overflow-hidden">
      <h2
        id="giant-footer-brand"
        class="text-[6.5vw] sm:text-[7.5vw] md:text-[8vw] lg:text-[7.6vw] font-black tracking-tighter leading-none text-transparent bg-clip-text bg-gradient-to-b from-foreground/25 via-foreground/10 to-transparent dark:from-foreground/20 dark:via-primary/10 dark:to-transparent hover:from-primary hover:via-primary/70 hover:to-primary/20 transition-all duration-700 cursor-default uppercase font-mono whitespace-nowrap"
        title="Manuja Medhankara"
      >
        MANUJA MEDHANKARA
      </h2>
    </div>

    <!-- Bottom Meta Copyright Bar -->
    <div class="pt-6 border-t border-border/40 dark:border-primary/15 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-[11px] text-muted-foreground">
      <div class="flex items-center gap-2">
        <Shield class="w-3.5 h-3.5 text-primary" />
        <span>&copy; {currentYear} Manuja Medhankara. All systems operational.</span>
      </div>

      <div class="flex items-center gap-4 text-muted-foreground/80">
        <span>Astro v5 + Anime.js v4</span>
        <span>•</span>
        <span>Zero-Trust Infrastructure</span>
      </div>
    </div>
  </div>
</footer>

<script>
  import { animate, createSpring } from 'animejs';

  function initFooterAnimations() {
    // Magnetic Spring on Back to Top Button
    const backToTopBtn = document.getElementById('footer-back-to-top');
    if (backToTopBtn) {
      backToTopBtn.addEventListener('mousemove', (e) => {
        const rect = backToTopBtn.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;

        animate(backToTopBtn, {
          x: x * 0.25,
          y: y * 0.25,
          duration: 150,
          ease: 'outQuad'
        });
      });

      backToTopBtn.addEventListener('mouseleave', () => {
        animate(backToTopBtn, {
          x: 0,
          y: 0,
          ease: createSpring({
            stiffness: 260,
            damping: 10
          })
        });
      });
    }

    // Giant Brand Hover Kinetic Pulse
    const brand = document.getElementById('giant-footer-brand');
    if (brand) {
      brand.addEventListener('mouseenter', () => {
        animate(brand, {
          scale: [1, 1.02, 1],
          duration: 600,
          ease: 'outBack'
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFooterAnimations);
  } else {
    initFooterAnimations();
  }
</script>
