---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { ArrowLeft } from 'lucide-astro';
---

<Layout title="404 — Route Not Found | Manuja Medhankara">
  <div class="relative min-h-screen flex flex-col justify-between p-6 md:p-12 bg-background text-foreground font-sans">
    <!-- Top Index Bar -->
    <div class="flex items-center justify-between border-b border-border pb-6">
      <div class="flex items-center gap-3 font-mono text-xs text-muted-foreground uppercase tracking-wider">
        <span class="w-2 h-2 bg-primary inline-block"></span>
        <span class="font-bold text-foreground">ERROR // 404</span>
        <span>/</span>
        <span>INDEX ROUTE FAULT</span>
      </div>

      <ThemeToggle />
    </div>

    <!-- Monumental Typographic Poster Body -->
    <div class="my-auto py-16 max-w-4xl space-y-6">
      <div class="font-mono text-xs font-bold text-primary uppercase tracking-widest">
        [ SYSTEM FAULT: HTTP_404_NOT_FOUND ]
      </div>
      <h1 class="text-7xl sm:text-9xl font-black uppercase tracking-tighter leading-none text-foreground">
        404
      </h1>
      <p class="text-xl sm:text-2xl text-muted-foreground font-medium max-w-xl leading-snug">
        The requested resource is unindexed or does not exist within the system directory.
      </p>
      <div class="pt-6">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3.5 bg-primary text-primary-foreground font-mono text-xs font-bold uppercase tracking-wider hover:bg-swiss-redDark transition-colors"
        >
          <ArrowLeft class="w-4 h-4" />
          <span>Return to Index</span>
        </a>
      </div>
    </div>

    <!-- Bottom Metadata Bar -->
    <div class="border-t border-border pt-6 flex flex-col sm:flex-row items-center justify-between font-mono text-xs text-muted-foreground gap-2">
      <span>MANUJA MEDHANKARA // SWISS ARCHITECTURE</span>
      <span>STATUS: 404_RESOLVED</span>
    </div>
  </div>
</Layout>

