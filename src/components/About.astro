---
import { ArrowUpRight, Check, Terminal, Shield, Cpu, Layers } from 'lucide-astro';

const toolchain = [
  "Kali Linux", "Metasploit", "Burp Suite", "Wireshark",
  "Python", "Bash", "Rust", "Tauri v2", "Docker", "AWS"
];

const specifications = [
  { label: "OPERATOR", value: "Manuja Medhankara", highlight: true },
  { label: "DISCIPLINE", value: "Offensive Security & Hardening", highlight: false },
  { label: "PRIMARY OS", value: "Arch Linux / Custom Kernel", highlight: false },
  { label: "SECURITY OS", value: "Kali Linux / Qubes OS", highlight: false },
  { label: "PRIMARY IDE", value: "Neovim (Lua Configured)", highlight: false },
  { label: "AUDIT METHOD", value: "CIS Benchmarks & NIST 800-53", highlight: false },
  { label: "INTEGRITY", value: "VERIFIED // 100% OPERATIONAL", highlight: true }
];
---

<section id="about" class="py-24 md:py-32 border-b border-border bg-background relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Index Header -->
    <div class="about-anim-item flex items-baseline justify-between pb-6 border-b border-border mb-12">
      <div class="flex items-center gap-3">
        <span class="swiss-number">01</span>
        <h2 class="text-xs font-mono font-bold uppercase tracking-widest text-foreground">
          // PROFILE &amp; SYSTEM SPECIFICATIONS
        </h2>
      </div>
      <span class="font-mono text-xs text-muted-foreground hidden sm:inline">
        DOC_ID: MM-SEC-2026
      </span>
    </div>

    <!-- Main Grid Structure -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Left Editorial Narrative (7 cols) -->
      <div class="lg:col-span-7 space-y-8 about-anim-item">
        <div class="space-y-4">
          <span class="swiss-tag">
            OVERVIEW
          </span>
          <h3 class="text-3xl sm:text-4xl md:text-5xl font-black uppercase tracking-tight text-foreground leading-[1.05]">
            Bridging Offensive Research with Hardened Systems Engineering.
          </h3>
        </div>

        <div class="space-y-4 text-muted-foreground text-sm sm:text-base leading-relaxed">
          <p>
            Specialized in rigorous web application security assessments, offensive vulnerability chaining, and low-level Linux infrastructure hardening. My approach combines the methodical precision of industrial standards with the lateral thinking of adversarial security testing.
          </p>
          <p>
            Beyond audits and compliance enforcement, I design and build high-speed desktop security utilities using Rust and Tauri, develop automated configuration auditors against CIS Benchmarks, and contribute to privacy-first open-source tools.
          </p>
        </div>

        <!-- Toolchain Matrix -->
        <div class="pt-6 border-t border-border">
          <div class="font-mono text-xs font-bold uppercase tracking-wider text-foreground mb-4">
            [ TOOLCHAIN &amp; ECOSYSTEM ]
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-5 gap-2">
            {toolchain.map((tool) => (
              <div class="p-2.5 border border-border bg-card font-mono text-xs text-foreground font-semibold text-center hover:border-primary transition-colors cursor-default select-none">
                {tool}
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Industrial Specification Table (5 cols) -->
      <div class="lg:col-span-5 border border-border bg-card p-6 md:p-8 space-y-6 about-anim-item">
        <div class="flex items-center justify-between pb-4 border-b border-border font-mono text-xs">
          <span class="font-bold text-foreground uppercase tracking-wider">
            [ SPECIFICATION SHEET ]
          </span>
          <span class="text-primary font-bold">STATUS: OK</span>
        </div>

        <!-- Key-Value Specifications -->
        <div class="divide-y divide-border font-mono text-xs">
          {specifications.map((spec) => (
            <div class="py-3.5 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
              <span class="text-muted-foreground tracking-wider uppercase font-medium">
                {spec.label}
              </span>
              <span class={`font-bold sm:text-right ${spec.highlight ? 'text-primary' : 'text-foreground'}`}>
                {spec.value}
              </span>
            </div>
          ))}
        </div>

        <div class="pt-4 border-t border-border flex items-center justify-between font-mono text-[11px] text-muted-foreground">
          <span class="flex items-center gap-1.5 text-foreground font-semibold">
            <span class="w-1.5 h-1.5 bg-primary"></span>
            ZERO-TRUST BASELINE
          </span>
          <span>UPTIME: 99.99%</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate, createTimeline, stagger } from 'animejs';

  function initAbout() {
    const aboutSection = document.getElementById('about');
    if (!aboutSection) return;

    let hasAnimated = false;

    function runEntrance() {
      if (hasAnimated) return;
      hasAnimated = true;

      const items = aboutSection?.querySelectorAll('.about-anim-item');
      if (items && items.length > 0) {
        createTimeline({ defaults: { ease: 'outExpo' } })
          .add(items, {
            opacity: [0, 1],
            translateY: [20, 0],
            delay: stagger(100),
            duration: 650
          });
      }
    }

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            runEntrance();
            observer.disconnect();
          }
        });
      }, { threshold: 0.1 });

      observer.observe(aboutSection);
    } else {
      runEntrance();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAbout);
  } else {
    initAbout();
  }
</script>
