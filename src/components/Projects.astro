---
import { Github, ChevronDown, ExternalLink, ArrowUpRight } from 'lucide-astro';

interface ProjectTimelineItem {
  id: string;
  index: string;
  title: string;
  url: string;
  status: 'completed' | 'in_development' | 'planned';
  statusLabel: string;
  phase: string;
  description: string;
  highlights: string[];
  tags: string[];
}

const projects: ProjectTimelineItem[] = [
  {
    id: "vulnradar",
    index: "01",
    title: "VulnRadar Security Scanner",
    url: "https://github.com/manuja-me/vuln-radar",
    status: "completed",
    statusLabel: "RELEASED",
    phase: "v0.7 PRODUCTION",
    description: "Enterprise-grade desktop security workstation & non-intrusive vulnerability scanner. Conducts real-time attack surface evaluations, cryptographic audits, port discovery, and OWASP remediation blueprinting.",
    highlights: [
      "Passive & non-destructive audits: HTTP security headers, cookie hygiene, and SSL/TLS cryptographic posture",
      "Attack surface heuristics: detects dangerous query parameters (?cmd=, ?tpl=), CVE banner correlation, and debug consoles",
      "High-speed async TCP port discovery with banner grabbing and target profile presets",
      "DNS & anti-spoofing verification: DoH inspection for SPF (v=spf1), DMARC policies (p=reject), and DNSSEC integrity",
      "Multi-source subdomain reconnaissance via Certificate Transparency logs (crt.sh) and passive DNS",
      "1-Click AI remediation prompts, continuous watchdog daemon, and local SQLite (WAL) privacy"
    ],
    tags: ["Rust", "Tauri v2", "Svelte 5", "Tailwind CSS", "SQLite WAL"]
  },
  {
    id: "linux-hardening",
    index: "02",
    title: "Linux Hardening Suite",
    url: "https://github.com/manuja-me",
    status: "in_development",
    statusLabel: "ACTIVE DEV",
    phase: "STAGING v1.0",
    description: "Automated security hardening suite for Linux servers following CIS benchmarks with customizable rule sets, dry-run validations, and automatic rollbacks.",
    highlights: [
      "Automated compliance checks aligned with CIS Benchmarks & NIST security baselines",
      "SSH, UFW/iptables firewall, kernel sysctl tuning, and strict user permission audits",
      "Non-destructive dry-run validation with automatic configuration backups and rollbacks",
      "Modular multi-distro architecture targeting Debian, Ubuntu, and Arch Linux"
    ],
    tags: ["Bash", "Python", "Linux Security", "CIS Benchmarks", "Automation"]
  },
  {
    id: "network-scanner",
    index: "03",
    title: "Network Recon Pro",
    url: "https://github.com/manuja-me",
    status: "planned",
    statusLabel: "PLANNED",
    phase: "ROADMAP",
    description: "Advanced network reconnaissance and asset discovery tool with service fingerprinting, vulnerability scanning, and automated reporting.",
    highlights: [
      "High-speed asynchronous port scanning with service and banner detection",
      "Integrated vulnerability script engine with CVE catalog matching",
      "Exportable security assessment reports in JSON, Markdown, and HTML formats"
    ],
    tags: ["Python", "Nmap", "Scapy", "Network Security"]
  }
];
---

<section id="projects" class="scroll-mt-16 py-16 sm:py-24 md:py-32 border-b border-border bg-background relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Index Header -->
    <div class="projects-anim-item flex items-baseline justify-between pb-4 sm:pb-6 border-b border-border mb-8 sm:mb-12">
      <div class="flex items-center gap-3">
        <span class="swiss-number">03</span>
        <h2 class="text-xs font-mono font-bold uppercase tracking-widest text-foreground">
          // SELECTED WORKS &amp; ROADMAP
        </h2>
      </div>
      <span class="font-mono text-xs text-muted-foreground hidden sm:inline">
        CATALOG_INDEX: 3_PROJECTS
      </span>
    </div>

    <!-- Section Intro Header -->
    <div class="max-w-3xl mb-8 sm:mb-12 space-y-2.5 sm:space-y-3 projects-anim-item">
      <span class="swiss-tag">OPEN SOURCE &amp; TOOLING</span>
      <h3 class="text-2xl sm:text-3xl md:text-4xl font-black uppercase tracking-tight text-foreground leading-[1.1]">
        Architected for Reliability &amp; Speed
      </h3>
      <p class="text-xs sm:text-sm md:text-base text-muted-foreground leading-relaxed">
        Chronological index of security tooling, automated hardening engines, and offensive auditing utilities.
      </p>
    </div>

    <!-- Swiss Catalog List -->
    <div class="border-t border-border divide-y divide-border">
      {projects.map((project) => (
        <div class="project-item group" data-project-id={project.id}>
          <!-- Row Header Container (Valid Semantic HTML without nested links in buttons) -->
          <div class="w-full py-5 sm:py-7 md:py-8 flex flex-col md:flex-row md:items-center justify-between gap-4 sm:gap-6 hover:bg-secondary/30 px-2 sm:px-4 -mx-2 sm:-mx-4 transition-colors">
            <!-- Left: Toggle Specs Button -->
            <button
              type="button"
              class="project-toggle-btn text-left flex items-start gap-3 sm:gap-6 flex-1 cursor-pointer focus:outline-none focus-visible:ring-1 focus-visible:ring-primary select-none"
              aria-expanded="false"
              aria-controls={`details-${project.id}`}
            >
              <span class="font-mono font-bold text-base sm:text-lg text-primary shrink-0 pt-0.5">
                {project.index}
              </span>
              <div class="space-y-1.5 flex-1">
                <div class="flex flex-wrap items-center gap-2 sm:gap-3">
                  <h4 class="text-lg sm:text-xl md:text-2xl font-black uppercase tracking-tight text-foreground group-hover:text-primary transition-colors">
                    {project.title}
                  </h4>
                  <span class="font-mono text-[9px] sm:text-[10px] uppercase font-bold px-1.5 py-0.5 border border-border bg-card text-foreground">
                    {project.statusLabel}
                  </span>
                  <span class="font-mono text-[9px] sm:text-[10px] text-muted-foreground tracking-wider uppercase">
                    [{project.phase}]
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-muted-foreground max-w-3xl leading-relaxed">
                  {project.description}
                </p>
              </div>
            </button>

            <!-- Right: Action Links & Dedicated Specs Toggle -->
            <div class="flex items-center justify-between md:justify-end gap-3 sm:gap-4 shrink-0 pl-7 sm:pl-12 md:pl-0 pt-2 md:pt-0 border-t md:border-t-0 border-border/50">
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="swiss-action-trigger p-2 border border-border bg-card hover:bg-secondary text-foreground hover:text-primary transition-colors inline-flex items-center justify-center"
                aria-label={`View ${project.title} source on GitHub`}
              >
                <Github class="w-4 h-4" />
              </a>

              <button
                type="button"
                class="project-specs-btn inline-flex items-center gap-1.5 font-mono text-xs text-muted-foreground hover:text-primary border border-border bg-card px-2.5 py-1.5 transition-colors cursor-pointer select-none"
                aria-expanded="false"
                aria-controls={`details-${project.id}`}
                aria-label={`Toggle specifications for ${project.title}`}
              >
                <span class="uppercase text-[11px] font-semibold">SPECS</span>
                <div class="chevron-icon transition-transform duration-300">
                  <ChevronDown class="w-4 h-4" />
                </div>
              </button>
            </div>
          </div>

          <!-- Expandable Technical Drawer -->
          <div
            id={`details-${project.id}`}
            class="project-drawer grid grid-rows-[0fr] opacity-0 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] overflow-hidden"
          >
            <div class="min-h-0 overflow-hidden">
              <div class="border-t border-dashed border-border bg-card/60 px-4 sm:px-6 md:px-8 py-6 sm:py-8 space-y-6">
                <!-- Visual Terminal / Engine Preview for VulnRadar -->
                {project.id === "vulnradar" && (
                  <div class="border border-border bg-background p-3.5 sm:p-4 font-mono text-xs space-y-2 max-w-4xl shadow-sm">
                    <div class="flex items-center justify-between border-b border-border pb-2 text-foreground font-bold text-[11px]">
                      <span class="text-primary flex items-center gap-1.5">
                        <span class="w-1.5 h-1.5 bg-primary"></span>
                        // VULNRADAR TELEMETRY ENGINE [EVALUATION LOG]
                      </span>
                      <span class="text-[10px] text-emerald-500 font-semibold">STATUS: PASSIVE_AUDIT_OK</span>
                    </div>
                    <div class="text-foreground font-semibold pt-1">
                      $ vulnradar scan --target https://target.corp --mode passive --all
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-1.5 text-[11px] text-muted-foreground pt-1">
                      <div>[+] TLS Handshake: TLS 1.3 / X25519 (0-RTT Verified)</div>
                      <div>[+] Anti-Spoofing: DMARC p=reject, SPF v=spf1</div>
                      <div class="text-emerald-500">[✓] CSP &amp; HSTS: max-age=31536000; includeSubDomains</div>
                      <div>[+] Subdomain CT Log Recon: 14 assets discovered</div>
                    </div>
                  </div>
                )}

                <div class="space-y-5 sm:space-y-6 max-w-4xl">
                  <!-- Feature List -->
                  <div class="space-y-2.5 sm:space-y-3">
                    <div class="font-mono text-[11px] sm:text-xs font-bold uppercase tracking-wider text-foreground">
                      [ ARCHITECTURAL CAPABILITIES &amp; SECURITY SCOPE ]
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5 sm:gap-3">
                      {project.highlights.map((highlight) => (
                        <div class="project-highlight-item flex items-start gap-2 font-mono text-xs text-muted-foreground">
                          <span class="text-primary font-bold shrink-0">―</span>
                          <span class="leading-relaxed">{highlight}</span>
                        </div>
                      ))}
                    </div>
                  </div>

                  <!-- Tech Stack & Direct URL -->
                  <div class="pt-4 sm:pt-6 border-t border-border flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4">
                    <div class="flex flex-wrap gap-1.5 font-mono text-[10px]">
                      {project.tags.map((tag) => (
                        <span class="px-2 py-0.5 border border-border bg-background text-foreground font-semibold">
                          {tag}
                        </span>
                      ))}
                    </div>

                    <a
                      href={project.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 font-mono text-xs font-bold uppercase tracking-wider text-primary hover:underline group/link self-start sm:self-auto"
                    >
                      <span>View Source</span>
                      <ArrowUpRight class="w-3.5 h-3.5 transition-transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5" />
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { animate, createTimeline, stagger } from 'animejs';

  function initProjects() {
    const projectsSection = document.getElementById('projects');
    if (!projectsSection) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let hasAnimated = false;

    function runEntrance() {
      if (hasAnimated) return;
      hasAnimated = true;

      const items = projectsSection?.querySelectorAll('.project-item, .projects-anim-item');
      if (items && items.length > 0) {
        if (prefersReducedMotion) {
          items.forEach((el) => {
            (el as HTMLElement).style.opacity = '1';
          });
        } else {
          createTimeline({ defaults: { ease: 'outExpo' } })
            .add(items, {
              opacity: [0, 1],
              translateY: [15, 0],
              delay: stagger(70),
              duration: 600
            });
        }
      }
    }

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            runEntrance();
            observer.disconnect();
          }
        });
      }, { threshold: 0.1 });

      observer.observe(projectsSection);
    } else {
      runEntrance();
    }

    // Flicker-Free Smooth Drawer Accordion
    const projectItems = document.querySelectorAll('.project-item');
    projectItems.forEach((item) => {
      const toggleBtn = item.querySelector('.project-toggle-btn');
      const specsBtn = item.querySelector('.project-specs-btn');
      const drawer = item.querySelector('.project-drawer') as HTMLElement;
      const chevron = item.querySelector('.chevron-icon');

      if (!drawer) return;

      function toggleAccordion() {
        const isExpanded = toggleBtn?.getAttribute('aria-expanded') === 'true';
        const nextState = !isExpanded;

        toggleBtn?.setAttribute('aria-expanded', nextState ? 'true' : 'false');
        specsBtn?.setAttribute('aria-expanded', nextState ? 'true' : 'false');

        if (nextState) {
          drawer.classList.remove('grid-rows-[0fr]', 'opacity-0');
          drawer.classList.add('grid-rows-[1fr]', 'opacity-100');

          if (!prefersReducedMotion) {
            const highlights = drawer.querySelectorAll('.project-highlight-item');
            animate(highlights, {
              translateY: [6, 0],
              opacity: [0, 1],
              delay: stagger(20),
              duration: 220,
              ease: 'outExpo'
            });

            if (chevron) {
              animate(chevron, {
                rotate: 180,
                duration: 250,
                ease: 'outExpo'
              });
            }
          } else if (chevron) {
            chevron.setAttribute('style', 'transform: rotate(180deg);');
          }
        } else {
          drawer.classList.remove('grid-rows-[1fr]', 'opacity-100');
          drawer.classList.add('grid-rows-[0fr]', 'opacity-0');

          if (!prefersReducedMotion && chevron) {
            animate(chevron, {
              rotate: 0,
              duration: 250,
              ease: 'outExpo'
            });
          } else if (chevron) {
            chevron.setAttribute('style', 'transform: rotate(0deg);');
          }
        }
      }

      toggleBtn?.addEventListener('click', toggleAccordion);
      specsBtn?.addEventListener('click', toggleAccordion);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjects);
  } else {
    initProjects();
  }
</script>
