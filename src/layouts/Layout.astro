---
import '../styles/global.css';
import { siteConfig, projects } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'profile' | 'article';
  canonical?: string;
  noindex?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  keywords = siteConfig.keywords,
  image = "/og-image.png",
  imageAlt = "Manuja Medhankara — Cybersecurity Specialist & Systems Engineer",
  ogType = "profile",
  canonical,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || siteConfig.url;
const canonicalURL = canonical || new URL(Astro.url.pathname, siteUrl).toString();
const imageURL = new URL(image, siteUrl).toString();
const robotsContent = noindex 
  ? 'noindex, nofollow' 
  : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';

// Schema.org Structured Data Graph
const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": siteConfig.author,
      "description": "Cybersecurity Specialist & Systems Engineer Portfolio",
      "publisher": { "@id": `${siteUrl}/#person` },
      "inLanguage": "en-US"
    },
    {
      "@type": "ProfilePage",
      "@id": `${canonicalURL}#profilepage`,
      "url": canonicalURL,
      "name": title,
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "about": { "@id": `${siteUrl}/#person` },
      "mainEntity": { "@id": `${siteUrl}/#person` },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "@id": `${siteUrl}/#og-image`,
        "url": imageURL,
        "width": 1200,
        "height": 630,
        "caption": imageAlt
      },
      "inLanguage": "en-US"
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}/#person`,
      "name": siteConfig.author,
      "alternateName": [siteConfig.username, siteConfig.shortName],
      "givenName": "Manuja",
      "familyName": "Medhankara",
      "gender": "Male",
      "jobTitle": "Cybersecurity Specialist & Systems Engineer",
      "description": description,
      "url": siteUrl,
      "image": imageURL,
      "email": `mailto:${siteConfig.email}`,
      "sameAs": [
        siteConfig.socials.github,
        siteConfig.socials.linkedin,
        siteConfig.socials.twitter
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Colombo",
        "addressCountry": "LK"
      },
      "knowsAbout": [
        "Cybersecurity",
        "Offensive Security",
        "Penetration Testing",
        "Vulnerability Assessment",
        "Linux Kernel Hardening",
        "CIS Benchmarks",
        "NIST SP 800-53",
        "Zero Trust Architecture",
        "Web Application Security",
        "Rust Systems Programming",
        "Tauri Framework",
        "Network Protocol Analysis",
        "Digital Forensics"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Cybersecurity & Systems Engineering Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Web Application Penetration Testing",
              "description": "Comprehensive offensive security assessments, vulnerability chaining, OWASP Top 10 mitigation, and REST/GraphQL API inspection."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Linux Infrastructure Hardening",
              "description": "Enterprise Linux hardening, kernel sysctl tuning, AppArmor/SELinux configuration, and automated compliance auditing aligned with CIS Benchmarks."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Custom Security Tooling Development",
              "description": "Engineering high-speed vulnerability scanners, automation daemons, and desktop defensive tooling in Rust, Tauri v2, and Python."
            }
          }
        ]
      }
    },
    {
      "@type": "ItemList",
      "@id": `${siteUrl}/#projects-list`,
      "name": "Featured Cybersecurity Tools & Projects",
      "itemListElement": projects.map((p, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "item": {
          "@type": p.schemaType,
          "name": p.title,
          "description": p.description,
          ...(p.version ? { "softwareVersion": p.version } : {}),
          ...(p.operatingSystem ? { "operatingSystem": p.operatingSystem, "applicationCategory": "SecurityApplication" } : {}),
          ...(p.programmingLanguage ? { "programmingLanguage": p.programmingLanguage } : {}),
          ...(p.schemaType === 'SoftwareSourceCode' ? { "codeRepository": p.url } : { "url": p.url }),
          "author": { "@id": `${siteUrl}/#person` }
        }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalURL}#breadcrumbs`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": siteUrl
        }
      ]
    }
  ]
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Core Primary Meta Tags -->
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Manuja Medhankara" />
    <meta name="creator" content="Manuja Medhankara" />
    <meta name="publisher" content="Manuja Medhankara" />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="bingbot" content={robotsContent} />
    <meta name="rating" content="general" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Local & Geographic Grounding (LK / Colombo) -->
    <meta name="geo.region" content="LK-1" />
    <meta name="geo.placename" content="Colombo" />
    <meta name="geo.position" content="6.9271;79.8612" />
    <meta name="ICBM" content="6.9271, 79.8612" />

    <!-- Mobile & PWA Theme Metadata -->
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FAFAFA" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#09090B" />
    <meta name="color-scheme" content="dark light" />
    <meta name="application-name" content="Manuja Medhankara" />
    <meta name="apple-mobile-web-app-title" content="Manuja.dev" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Favicon, Manifest & Machine Discovery -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=2" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Context Summary" />

    <!-- Open Graph / Facebook / LinkedIn / Discord -->
    <meta property="og:site_name" content="Manuja Medhankara" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:secure_url" content={imageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="profile:first_name" content="Manuja" />
    <meta property="profile:last_name" content="Medhankara" />
    <meta property="profile:username" content="manuja_me" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@manuja_me" />
    <meta name="twitter:creator" content="@manuja_me" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-QPWZ92Z5SS"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-QPWZ92Z5SS');
    </script>

    <!-- CDN Preconnect & DNS Prefetch for Fonts & Analytics -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />

    <!-- Security Headers & Policies -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net data:; img-src 'self' data: https:; connect-src 'self' https://cloudflareinsights.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self';" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />

    <!-- JSON-LD Structured Data Schema.org Graph (Escaped against HTML script breakouts) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaGraph).replace(/</g, '\\u003c')} />

    <!-- Instant theme initialization to prevent flash -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const isDark = stored ? stored === 'dark' : true;
          if (isDark) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground font-sans selection:bg-primary selection:text-white">
    <slot />

    <!-- Global Delegated Clipboard Copy Controller -->
    <script>
      document.addEventListener('click', async (e) => {
        const trigger = (e.target as HTMLElement)?.closest<HTMLElement>('[data-copy]');
        if (!trigger) return;
        const textToCopy = trigger.getAttribute('data-copy');
        if (!textToCopy) return;

        const labelEl = trigger.querySelector<HTMLElement>('[data-copy-label]') || trigger;
        const originalText = labelEl.innerText;
        const copiedText = trigger.getAttribute('data-copied-text') || 'COPIED!';

        try {
          await navigator.clipboard.writeText(textToCopy);
          labelEl.innerText = copiedText;
          trigger.classList.add('border-primary', 'text-primary');
          setTimeout(() => {
            labelEl.innerText = originalText;
            trigger.classList.remove('border-primary', 'text-primary');
          }, 2000);
        } catch {
          labelEl.innerText = 'ERR';
          setTimeout(() => {
            labelEl.innerText = originalText;
          }, 2000);
        }
      });
    </script>
  </body>
</html>
