---
import { Github, ChevronDown, ExternalLink } from 'lucide-astro';

interface ProjectTimelineItem {
  id: string;
  title: string;
  url: string;
  status: 'completed' | 'in_development' | 'planned';
  statusLabel: string;
  badgeColor: string;
  phase: string;
  description: string;
  highlights: string[];
  tags: string[];
}

const projects: ProjectTimelineItem[] = [
  {
    id: "vulnradar",
    title: "VulnRadar",
    url: "https://github.com/manuja-me/vuln-radar",
    status: "completed",
    statusLabel: "Built & Released",
    badgeColor: "text-emerald-700 dark:text-emerald-400 border-emerald-600/30 dark:border-emerald-500/30 bg-emerald-500/10",
    phase: "v0.7 Active",
    description: "Desktop Web Vulnerability & Security Posture Scanner. Conducts passive audits on security headers, cookie policies, client-side CVE dependency risks, and credential leaks with automated risk scoring.",
    highlights: [
      "Automated HTTP security header audits (CSP, HSTS, X-Frame-Options, COOP, Permissions-Policy)",
      "Cookie security inspection (HttpOnly, Secure, SameSite attribute validation)",
      "Client-side CVE dependency risk detection & sensitive key exposure scanning",
      "Embedded SQLite history database with automated security health rating (0-100)"
    ],
    tags: ["Rust", "Tauri v2", "Svelte 5", "TypeScript", "SQLite"]
  },
  {
    id: "linux-hardening",
    title: "Linux Hardening Script",
    url: "https://github.com/manuja-me",
    status: "in_development",
    statusLabel: "Up Next / In Dev",
    badgeColor: "text-amber-700 dark:text-amber-400 border-amber-600/30 dark:border-amber-500/30 bg-amber-500/10",
    phase: "Next Release",
    description: "Automated security hardening suite for Linux servers following CIS benchmarks with customizable rule sets and non-destructive audits.",
    highlights: [
      "Automated compliance checks aligned with CIS Benchmarks & NIST security baselines",
      "SSH, UFW/iptables firewall, kernel sysctl tuning, and strict user permission audits",
      "Non-destructive dry-run validation with automatic configuration backups and rollbacks",
      "Modular multi-distro architecture targeting Debian, Ubuntu, and Arch Linux"
    ],
    tags: ["Bash", "Python", "Linux Security", "CIS Benchmarks", "Automation"]
  },
  {
    id: "network-scanner",
    title: "Network Scanner Pro",
    url: "https://github.com/manuja-me",
    status: "planned",
    statusLabel: "Planned",
    badgeColor: "text-primary border-primary/20 bg-primary/5",
    phase: "Roadmap",
    description: "Advanced network reconnaissance and asset discovery tool with service fingerprinting, vulnerability scanning, and automated reporting.",
    highlights: [
      "High-speed asynchronous port scanning with service and banner detection",
      "Integrated vulnerability script engine with CVE catalog matching",
      "Exportable security assessment reports in JSON, Markdown, and HTML formats"
    ],
    tags: ["Python", "Nmap", "Scapy", "Reconnaissance"]
  }
];
---

<section id="projects" class="min-h-screen py-24 px-6 relative flex items-center">
  <div class="container mx-auto max-w-5xl">
    <!-- Section Header -->
    <div class="mb-16 projects-header-anim">
      <div class="inline-block mb-4 cursor-pointer group" id="projects-cmd-badge">
        <span class="text-primary font-mono text-sm font-semibold anime-decrypt-target" data-original-text="$ git log --graph --timeline">$ git log --graph --timeline</span>
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-4 text-foreground anime-decrypt-target cursor-pointer" data-original-text="Project Timeline">
        Project <span class="gradient-text">Timeline</span>
      </h2>
      <p class="text-lg text-muted-foreground font-mono max-w-2xl">
        A chronological roadmap of security tools, active development, and upcoming releases. Click any item to expand details.
      </p>
    </div>

    <!-- Timeline Container -->
    <div class="relative border-l border-primary/20 dark:border-primary/25 ml-2 md:ml-3 pl-6 md:pl-8 space-y-6">
      {projects.map((project) => (
        <div class="relative group timeline-item" data-project-id={project.id}>
          <!-- Minimal Precision Node Dot on Timeline Spine -->
          <div class="timeline-node absolute -left-[31px] md:-left-[39px] top-7 flex items-center justify-center pointer-events-none">
            {project.status === 'completed' && (
              <div class="relative flex items-center justify-center">
                <div class="w-3.5 h-3.5 rounded-full border-2 border-emerald-500 bg-background flex items-center justify-center shadow-[0_0_8px_rgba(16,185,129,0.5)]">
                  <div class="w-1.5 h-1.5 rounded-full bg-emerald-500" />
                </div>
              </div>
            )}
            {project.status === 'in_development' && (
              <div class="relative flex items-center justify-center">
                <span class="animate-ping absolute inline-flex h-4 w-4 rounded-full bg-amber-400/40" />
                <div class="w-3.5 h-3.5 rounded-full border-2 border-amber-500 bg-background flex items-center justify-center shadow-[0_0_8px_rgba(245,158,11,0.5)]">
                  <div class="w-1.5 h-1.5 rounded-full bg-amber-500" />
                </div>
              </div>
            )}
            {project.status === 'planned' && (
              <div class="relative flex items-center justify-center">
                <div class="w-3.5 h-3.5 rounded-full border border-border/80 dark:border-primary/40 bg-background flex items-center justify-center">
                  <div class="w-1 h-1 rounded-full bg-muted-foreground/50 dark:bg-primary/40" />
                </div>
              </div>
            )}
          </div>

          <!-- Expandable Card -->
          <div class="timeline-card rounded-xl border border-border/80 bg-card/90 dark:bg-card/80 backdrop-blur-md hover:border-primary/50 transition-all duration-300 shadow-sm hover:shadow-md overflow-hidden">
            <!-- Card Header / Toggle Button (Minimized by Default) -->
            <button
              type="button"
              class="w-full p-6 md:p-7 text-left flex items-start justify-between gap-4 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary timeline-toggle-btn"
              aria-expanded="false"
              aria-controls={`details-${project.id}`}
            >
              <div class="space-y-2 flex-1">
                <div class="flex flex-wrap items-center gap-2.5">
                  <span class={`text-xs px-2.5 py-0.5 rounded-full border font-mono font-semibold ${project.badgeColor}`}>
                    {project.statusLabel}
                  </span>
                  <span class="text-xs text-muted-foreground font-mono">
                    [{project.phase}]
                  </span>
                </div>

                <h3 class="text-xl md:text-2xl font-bold text-foreground group-hover:text-primary transition-colors">
                  {project.title}
                </h3>

                <p class="text-sm text-muted-foreground font-mono leading-relaxed">
                  {project.description}
                </p>
              </div>

              <!-- Action & Expand Icon -->
              <div class="flex items-center gap-2.5 shrink-0 pt-1">
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`View ${project.title} on GitHub`}
                  class="p-2 rounded-md hover:bg-primary/10 text-muted-foreground hover:text-primary transition-colors"
                  onclick="event.stopPropagation()"
                >
                  <Github class="w-4 h-4" />
                </a>
                <div
                  class="p-1.5 rounded-md bg-muted/50 text-foreground group-hover:bg-primary/10 group-hover:text-primary transition-all duration-300 chevron-icon"
                  title="Toggle details"
                >
                  <ChevronDown class="w-4 h-4" />
                </div>
              </div>
            </button>

            <!-- Collapsible Body Content (Hidden by default) -->
            <div
              id={`details-${project.id}`}
              class="hidden overflow-hidden border-t border-border/40 timeline-details-content"
            >
              <div class="p-6 md:p-7 pt-4 space-y-5 bg-primary/[0.02] details-inner-wrap">
                <!-- Key Highlights -->
                <div>
                  <h4 class="text-xs font-mono font-semibold text-primary uppercase tracking-wider mb-3">
                    // Key Features & Scope
                  </h4>
                  <ul class="space-y-2">
                    {project.highlights.map((highlight) => (
                      <li class="project-highlight-item flex items-start gap-2 text-sm text-foreground/90 font-mono">
                        <span class="text-primary font-bold mt-0.5 text-xs">▹</span>
                        <span>{highlight}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Tech Badges & Direct Action Link -->
                <div class="flex flex-wrap items-center justify-between gap-4 pt-2 border-t border-border/40">
                  <div class="flex flex-wrap gap-1.5">
                    {project.tags.map((tag) => (
                      <span class="text-xs px-2 py-0.5 bg-primary/10 text-primary border border-primary/20 rounded font-mono font-medium">
                        {tag}
                      </span>
                    ))}
                  </div>

                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-primary hover:underline group/link"
                  >
                    <span>View Repository</span>
                    <ExternalLink class="w-3.5 h-3.5 transition-transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5" />
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { animate, createTimeline, stagger, createSpring } from 'animejs';

  function initTimeline() {
    const projectsSection = document.getElementById('projects');
    if (!projectsSection) return;

    let hasAnimated = false;

    function runEntrance() {
      if (hasAnimated) return;
      hasAnimated = true;

      const tl = createTimeline({ defaults: { ease: 'outBack' } });

      tl.add('.projects-header-anim', {
        opacity: [0, 1],
        translateY: [30, 0],
        duration: 600
      })
      .add('.timeline-item', {
        opacity: [0, 1],
        translateX: [-25, 0],
        delay: stagger(120),
        duration: 600
      }, '-=300');
    }

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            runEntrance();
            observer.disconnect();
          }
        });
      }, { threshold: 0.15 });

      observer.observe(projectsSection);
    } else {
      runEntrance();
    }

    // Anime.js Accordion Expand / Collapse
    const items = document.querySelectorAll('.timeline-item');
    items.forEach((item) => {
      const btn = item.querySelector('.timeline-toggle-btn');
      const content = item.querySelector('.timeline-details-content') as HTMLElement;
      const chevron = item.querySelector('.chevron-icon');

      if (!btn || !content) return;

      btn.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) return;

        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        const nextState = !isExpanded;

        btn.setAttribute('aria-expanded', nextState ? 'true' : 'false');

        if (nextState) {
          content.classList.remove('hidden');
          content.classList.add('block');
          
          const fullHeight = content.scrollHeight;
          
          animate(content, {
            height: [0, fullHeight],
            opacity: [0, 1],
            duration: 350,
            ease: 'outQuart',
            onComplete: () => {
              content.style.height = 'auto';
            }
          });

          const highlights = content.querySelectorAll('.project-highlight-item');
          animate(highlights, {
            translateX: [-15, 0],
            opacity: [0, 1],
            delay: stagger(40),
            duration: 300,
            ease: 'outBack'
          });

          if (chevron) {
            animate(chevron, {
              rotate: 180,
              duration: 250,
              ease: 'outBack'
            });
          }
        } else {
          const currentHeight = content.offsetHeight;
          animate(content, {
            height: [currentHeight, 0],
            opacity: [1, 0],
            duration: 250,
            ease: 'inOutQuad',
            onComplete: () => {
              content.classList.remove('block');
              content.classList.add('hidden');
            }
          });

          if (chevron) {
            animate(chevron, {
              rotate: 0,
              duration: 250,
              ease: 'outBack'
            });
          }
        }
      });
    });

    // Decrypt on badge hover
    const badge = document.getElementById('projects-cmd-badge');
    if (badge) {
      badge.addEventListener('mouseenter', () => {
        const span = badge.querySelector('.anime-decrypt-target') as HTMLElement;
        if (!span) return;
        const original = span.getAttribute('data-original-text') || span.textContent || '';
        const chars = '01#$*&abcdef';
        let iter = 0;
        const int = setInterval(() => {
          span.textContent = original
            .split('')
            .map((c, i) => (c === ' ' ? ' ' : i < iter ? original[i] : chars[Math.floor(Math.random() * chars.length)]))
            .join('');
          if (iter >= original.length) clearInterval(int);
          iter += 1/2;
        }, 30);
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTimeline);
  } else {
    initTimeline();
  }
</script>

