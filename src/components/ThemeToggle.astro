---
import { Sun, Moon } from 'lucide-astro';
---

<button
  id="theme-toggle"
  type="button"
  role="switch"
  aria-label="Toggle dark/light theme"
  class="inline-flex items-center gap-2 border border-border bg-card hover:bg-secondary text-foreground px-2.5 py-1.5 font-mono text-[11px] font-semibold tracking-wider uppercase transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-primary cursor-pointer select-none"
>
  <span class="w-1.5 h-1.5 rounded-none bg-primary inline-block"></span>
  <span id="theme-toggle-label-light" class="dark:hidden flex items-center gap-1.5">
    <Sun class="h-3 w-3 text-primary" />
    <span>LIGHT</span>
  </span>
  <span id="theme-toggle-label-dark" class="hidden dark:flex items-center gap-1.5">
    <Moon class="h-3 w-3 text-primary" />
    <span>DARK</span>
  </span>
</button>

<script is:inline>
  (function () {
    function initToggle() {
      const toggle = document.getElementById('theme-toggle');
      if (!toggle) return;

      function syncAria() {
        const isDark = document.documentElement.classList.contains('dark');
        toggle.setAttribute('aria-checked', isDark ? 'true' : 'false');
      }

      syncAria();

      toggle.onclick = function () {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch (e) {}
        syncAria();
        window.dispatchEvent(new CustomEvent('theme-change', { detail: { isDark: isDark } }));
      };
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initToggle);
    } else {
      initToggle();
    }
  })();
</script>
