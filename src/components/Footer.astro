---
import { ArrowUp, ArrowUpRight, Shield, Terminal } from 'lucide-astro';

const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-border bg-background relative overflow-hidden">
  <!-- Giant Architectural Poster Wordmark -->
  <div class="px-4 sm:px-6 lg:px-8 py-6 sm:py-8 md:py-12 border-b border-border select-none overflow-hidden">
    <h2
      id="giant-footer-brand"
      class="text-[9.5vw] font-black tracking-tighter leading-none text-foreground hover:text-primary transition-colors duration-500 cursor-default uppercase whitespace-nowrap block"
      title="Manuja Medhankara"
    >
      MANUJA MEDHANKARA
    </h2>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- 4-Column Modular Swiss Directory -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 sm:gap-10 pb-10 sm:pb-16 border-b border-border">
      <!-- Col 1: Brand & Discipline (5 cols) -->
      <div class="lg:col-span-5 space-y-3 sm:space-y-4">
        <div class="flex items-center gap-2 font-mono text-xs font-bold text-foreground uppercase tracking-wider">
          <span class="w-2 h-2 bg-primary"></span>
          <span>DISCIPLINE &amp; RESEARCH</span>
        </div>
        <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed max-w-sm">
          Cybersecurity specialist &amp; systems engineer. Focused on offensive penetration testing, defensive Linux kernel hardening, and high-performance security utilities.
        </p>
        <div class="font-mono text-[11px] sm:text-xs text-muted-foreground pt-1 sm:pt-2">
          LOCATION: COLOMBO [LK] // UTC+05:30
        </div>
      </div>

      <!-- Col 2: Index (2 cols) -->
      <div class="lg:col-span-2 space-y-2.5 sm:space-y-3 font-mono text-xs">
        <div class="font-bold text-foreground uppercase tracking-wider mb-2 sm:mb-4">
          // INDEX
        </div>
        <ul class="space-y-1.5 sm:space-y-2 text-muted-foreground">
          <li>
            <a href="#hero" class="hover:text-primary transition-colors flex items-center gap-1.5">
              <span class="text-primary font-bold">00</span> Home
            </a>
          </li>
          <li>
            <a href="#about" class="hover:text-primary transition-colors flex items-center gap-1.5">
              <span class="text-primary font-bold">01</span> About
            </a>
          </li>
          <li>
            <a href="#skills" class="hover:text-primary transition-colors flex items-center gap-1.5">
              <span class="text-primary font-bold">02</span> Capabilities
            </a>
          </li>
          <li>
            <a href="#projects" class="hover:text-primary transition-colors flex items-center gap-1.5">
              <span class="text-primary font-bold">03</span> Works
            </a>
          </li>
          <li>
            <a href="#contact" class="hover:text-primary transition-colors flex items-center gap-1.5">
              <span class="text-primary font-bold">04</span> Contact
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Repositories (3 cols) -->
      <div class="lg:col-span-3 space-y-2.5 sm:space-y-3 font-mono text-xs">
        <div class="font-bold text-foreground uppercase tracking-wider mb-2 sm:mb-4">
          // REPOSITORIES
        </div>
        <ul class="space-y-1.5 sm:space-y-2 text-muted-foreground">
          <li>
            <a
              href="https://github.com/manuja-me/vuln-radar"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-primary transition-colors inline-flex items-center gap-1"
            >
              <span>VulnRadar Scanner</span>
              <ArrowUpRight class="w-3 h-3 opacity-60" />
            </a>
          </li>
          <li>
            <a
              href="https://github.com/manuja-me"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-primary transition-colors inline-flex items-center gap-1"
            >
              <span>Linux Hardening Suite</span>
              <ArrowUpRight class="w-3 h-3 opacity-60" />
            </a>
          </li>
          <li>
            <a
              href="https://github.com/manuja-me"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-primary transition-colors inline-flex items-center gap-1"
            >
              <span>GitHub Profile</span>
              <ArrowUpRight class="w-3 h-3 opacity-60" />
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/manuja-medhankara-rc96"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-primary transition-colors inline-flex items-center gap-1"
            >
              <span>LinkedIn Network</span>
              <ArrowUpRight class="w-3 h-3 opacity-60" />
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Top & Security (2 cols) -->
      <div class="lg:col-span-2 flex flex-col justify-between space-y-4 sm:space-y-6 font-mono text-xs pt-4 md:pt-0 border-t md:border-t-0 border-border/50">
        <div class="space-y-2">
          <div class="font-bold text-foreground uppercase tracking-wider mb-2 sm:mb-4">
            // PROTOCOL
          </div>
          <a href="/security.txt" class="block text-muted-foreground hover:text-primary transition-colors">
            security.txt ↗
          </a>
          <span class="block text-muted-foreground text-[11px]">
            PGP: 0x4E5AB5C
          </span>
        </div>

        <!-- Back to Top Button -->
        <div>
          <a
            id="footer-back-to-top"
            href="#hero"
            class="swiss-magnetic-btn inline-flex items-center justify-between w-full p-3 border border-border bg-card hover:bg-secondary text-foreground font-bold uppercase tracking-wider transition-colors cursor-pointer text-xs"
            aria-label="Back to top"
          >
            <span>TOP OF PAGE</span>
            <ArrowUp class="w-3.5 h-3.5 text-primary" />
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Meta Copyright Bar -->
    <div class="pt-6 sm:pt-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-4 font-mono text-[11px] sm:text-xs text-muted-foreground">
      <div class="flex items-center gap-2">
        <span>&copy; {currentYear} MANUJA MEDHANKARA. ALL RIGHTS RESERVED.</span>
      </div>

      <div class="flex items-center gap-3 text-[10px] sm:text-[11px]">
        <span>ASTRO + ANIME.JS</span>
        <span>/</span>
        <span>SWISS TYPOGRAPHIC STYLE</span>
      </div>
    </div>
  </div>
</footer>

<script>
  import { animate, createSpring } from 'animejs';

  function initFooter() {
    const backToTopBtn = document.getElementById('footer-back-to-top');
    if (backToTopBtn) {
      backToTopBtn.addEventListener('mousemove', (e) => {
        const rect = backToTopBtn.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;

        animate(backToTopBtn, {
          x: x * 0.15,
          y: y * 0.15,
          duration: 120,
          ease: 'outQuad'
        });
      });

      backToTopBtn.addEventListener('mouseleave', () => {
        animate(backToTopBtn, {
          x: 0,
          y: 0,
          ease: createSpring({
            stiffness: 300,
            damping: 12
          })
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFooter);
  } else {
    initFooter();
  }
</script>
