---
import { ArrowDown, ArrowUpRight, Shield, Terminal, Lock, Mail, Github, Linkedin } from 'lucide-astro';
---

<section id="hero" class="relative pt-20 pb-12 sm:pt-24 sm:pb-16 md:pt-32 md:pb-24 border-b border-border overflow-hidden bg-background">
  <!-- Subtle Swiss Grid Background Pattern -->
  <div class="absolute inset-0 swiss-grid-pattern opacity-60 dark:opacity-30 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Top Meta Index Bar -->
    <div class="hero-anim-item flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 sm:gap-4 pb-4 sm:pb-6 border-b border-border font-mono text-xs text-muted-foreground uppercase tracking-wider">
      <div class="flex flex-wrap items-center gap-2 sm:gap-3">
        <span class="inline-flex items-center justify-center bg-primary text-white text-[10px] font-bold px-1.5 py-0.5 shrink-0">
          SYS.00
        </span>
        <span class="font-bold text-foreground">MANUJA MEDHANKARA</span>
        <span class="text-border">/</span>
        <span class="text-[11px] sm:text-xs">PORTFOLIO &amp; SPECIFICATION</span>
      </div>

      <div class="flex flex-wrap items-center gap-2 sm:gap-4 text-[11px]">
        <span>LOC: COLOMBO [LK]</span>
        <span class="text-border hidden sm:inline">/</span>
        <span class="text-primary font-semibold">STATUS: AVAILABLE FOR AUDITS</span>
      </div>
    </div>

    <!-- Main Typographic Hero Poster Block -->
    <div class="py-8 sm:py-12 md:py-16 border-b border-border">
      <div class="hero-anim-item space-y-3 sm:space-y-4">
        <div class="inline-block font-mono text-[11px] sm:text-xs font-bold tracking-widest text-primary uppercase">
          // CYBERSECURITY SPECIALIST &amp; SYSTEMS BUILDER
        </div>

        <h1 
          id="hero-main-title"
          class="text-4xl sm:text-6xl md:text-8xl lg:text-[7.2rem] font-black uppercase tracking-tighter leading-[0.92] sm:leading-[0.9] text-foreground select-none cursor-pointer anime-decrypt-target break-words"
          data-original-text="MANUJA MEDHANKARA"
          title="Click to scramble / decrypt typography"
        >
          MANUJA<br />MEDHANKARA
        </h1>
      </div>
    </div>

    <!-- Asymmetric 3-Column Swiss Information Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 py-8 sm:py-10 border-b border-border">
      <!-- Col 1: Specialization & Core Pillars (4 cols) -->
      <div class="md:col-span-4 space-y-5 md:border-r md:border-border md:pr-8 border-b md:border-b-0 border-border pb-8 md:pb-0 hero-anim-item">
        <div class="font-mono text-xs font-bold uppercase tracking-wider text-muted-foreground">
          [ 00.1 ] FOCUS DOMAINS
        </div>
        
        <div class="space-y-2 font-mono text-xs">
          <div class="flex items-center gap-2 p-2.5 border border-border bg-card">
            <span class="w-1.5 h-1.5 bg-primary shrink-0"></span>
            <span class="font-bold text-foreground">Penetration Testing</span>
            <span class="ml-auto text-muted-foreground text-[11px]">WEB / API</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 border border-border bg-card">
            <span class="w-1.5 h-1.5 bg-primary shrink-0"></span>
            <span class="font-bold text-foreground">Linux Hardening</span>
            <span class="ml-auto text-muted-foreground text-[11px]">CIS / KERNEL</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 border border-border bg-card">
            <span class="w-1.5 h-1.5 bg-primary shrink-0"></span>
            <span class="font-bold text-foreground">Security Tooling</span>
            <span class="ml-auto text-muted-foreground text-[11px]">RUST / TAURI</span>
          </div>
        </div>
      </div>

      <!-- Col 2: Engineering Philosophy Statement (5 cols) -->
      <div class="md:col-span-5 space-y-4 md:border-r md:border-border md:pr-8 border-b md:border-b-0 border-border pb-8 md:pb-0 hero-anim-item">
        <div class="font-mono text-xs font-bold uppercase tracking-wider text-muted-foreground">
          [ 00.2 ] MISSION &amp; PHILOSOPHY
        </div>
        <p class="text-base sm:text-lg text-foreground font-medium leading-snug tracking-tight">
          Engineering resilient defensive architectures and conducting rigorous offensive security assessments. Committed to high-performance open-source tools and zero-trust verification.
        </p>
        <p class="font-mono text-xs text-muted-foreground leading-relaxed">
          Primary research targets include attack surface discovery, cryptographic posture verification, and automated Linux compliance.
        </p>
      </div>

      <!-- Col 3: Direct Action Matrix (3 cols) -->
      <div class="md:col-span-3 flex flex-col justify-between space-y-4 hero-anim-item">
        <div>
          <div class="font-mono text-xs font-bold uppercase tracking-wider text-muted-foreground mb-3 sm:mb-4">
            [ 00.3 ] DIRECT ACTIONS
          </div>

          <a
            id="hero-cta-btn"
            href="mailto:manuja.public@gmail.com?subject=Security%20Inquiry%20from%20Portfolio&body=Hello%20Manuja,%0A%0AI'm%20reaching%20out%20regarding..."
            class="swiss-magnetic-btn w-full inline-flex items-center justify-between px-5 py-3.5 bg-primary text-primary-foreground font-mono text-xs font-bold uppercase tracking-wider hover:bg-swiss-redDark transition-colors group select-none shadow-sm cursor-pointer"
          >
            <span>Initiate Contact</span>
            <ArrowUpRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </a>
        </div>

        <div class="grid grid-cols-2 gap-2 pt-1">
          <a
            href="https://github.com/manuja-me"
            target="_blank"
            rel="noopener noreferrer"
            class="swiss-magnetic-btn inline-flex items-center justify-center gap-1.5 p-3 border border-border bg-card hover:bg-secondary text-foreground font-mono text-xs font-bold uppercase transition-colors"
          >
            <Github class="w-3.5 h-3.5" />
            <span>GitHub</span>
          </a>
          <a
            href="https://www.linkedin.com/in/manuja-medhankara-rc96"
            target="_blank"
            rel="noopener noreferrer"
            class="swiss-magnetic-btn inline-flex items-center justify-center gap-1.5 p-3 border border-border bg-card hover:bg-secondary text-foreground font-mono text-xs font-bold uppercase transition-colors"
          >
            <Linkedin class="w-3.5 h-3.5" />
            <span>LinkedIn</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Structural Index Anchor Bar -->
    <div class="pt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs font-mono text-muted-foreground">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 border border-primary"></span>
        <span>SCROLL DOWN FOR SPECIFICATIONS</span>
      </div>

      <a
        href="#about"
        class="inline-flex items-center gap-1.5 text-foreground hover:text-primary transition-colors font-bold uppercase"
        aria-label="Proceed to About Section"
      >
        <span>INDEX 01</span>
        <ArrowDown class="w-3.5 h-3.5 text-primary" />
      </a>
    </div>
  </div>
</section>

<script>
  import { animate, createTimeline, createSpring, stagger } from 'animejs';

  function initHero() {
    // Staggered Entrance Animation
    const heroItems = document.querySelectorAll('.hero-anim-item');
    if (heroItems.length > 0) {
      createTimeline({ defaults: { ease: 'outExpo' } })
        .add(heroItems, {
          opacity: [0, 1],
          translateY: [20, 0],
          delay: stagger(90),
          duration: 650
        });
    }

    // Typographic Kinetic Scramble
    function runDecryptEffect(el: HTMLElement) {
      if ((el as any)._decryptInterval) {
        clearInterval((el as any)._decryptInterval);
      }

      const original = el.getAttribute('data-original-text') || el.innerText || '';
      const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#$*-_+/';
      let iteration = 0;

      const interval = setInterval(() => {
        el.innerText = original
          .split('')
          .map((char, index) => {
            if (char === ' ' || char === '\n') return char;
            if (index < iteration) return original[index];
            return chars[Math.floor(Math.random() * chars.length)];
          })
          .join('');

        if (iteration >= original.length) {
          clearInterval(interval);
          (el as any)._decryptInterval = null;
        }
        iteration += 0.35;
      }, 35);

      (el as any)._decryptInterval = interval;
    }

    const mainTitle = document.getElementById('hero-main-title');
    if (mainTitle) {
      mainTitle.addEventListener('click', () => runDecryptEffect(mainTitle));
      setTimeout(() => runDecryptEffect(mainTitle), 400);
    }

    // Magnetic Button Spring Physics
    const magneticButtons = document.querySelectorAll('.swiss-magnetic-btn') as NodeListOf<HTMLElement>;
    magneticButtons.forEach((btn) => {
      btn.addEventListener('mousemove', (e) => {
        const rect = btn.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;

        animate(btn, {
          x: x * 0.2,
          y: y * 0.2,
          duration: 120,
          ease: 'outQuad'
        });
      });

      btn.addEventListener('mouseleave', () => {
        animate(btn, {
          x: 0,
          y: 0,
          ease: createSpring({
            stiffness: 300,
            damping: 12
          })
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero);
  } else {
    initHero();
  }
</script>
